// Interface do Polley nativo. O Rust (src/) só preenche as propriedades e responde aos callbacks.

import { LineEdit } from "std-widgets.slint";
import { ListView, CheckBox, TextEdit, ComboBox, Slider } from "std-widgets.slint";

// Um pedaço dos Termos/Política: 0 = parágrafo, 1 = título, 2 = item de lista, 3 = espaço.
export struct LegalBlock {
    kind: int,
    text: string,
}

// Linha da lista de membros (header = título "ONLINE — 3").
export struct MemberItem {
    id: string,
    name: string,
    initials: string,
    avatar: string,
    color: color,
    online: bool,
    activity: string,  // jogo que está jogando ("" = nenhum)
    role: string,      // "owner" | "admin" | "member"
    header: bool,
}

// Jogo adicionado à mão em "Jogos registrados".
export struct GameItem {
    exe: string,
    name: string,
}

// Item da barra lateral das configurações (head = título de grupo).
export struct SettingsNav {
    id: string,
    label: string,
    head: bool,
}

export struct BanItem {
    id: string,
    name: string,
    initials: string,
    avatar: string,
    color: color,
}

export struct ServerItem {
    id: string,
    name: string,
    icon: string,   // URL do ícone ("" = iniciais)
    initials: string,
    unread: bool,   // algum canal com mensagem não lida
    mentions: int,  // menções a mim não lidas
}

// Arquivo anexado numa mensagem.
export struct AttachmentItem {
    url: string,
    name: string,
    size: string,   // "1.2 MB"
    image: bool,
    video: bool,
}

// Uma reação somada: 👍 3 (mine = eu também reagi com ela).
export struct ReactionItem {
    emoji: string,
    count: int,
    mine: bool,
}

export struct MessageItem {
    id: string,
    author: string,
    author-id: string,
    avatar: string,    // URL da foto ("" = iniciais)
    initials: string,
    color: color,
    time: string,
    content: string,
    grouped: bool,
    mine: bool,
    can-delete: bool,
    edited: bool,
    attachments: [AttachmentItem],
    reply-id: string,      // "" = não é resposta
    reply-author: string,
    reply-text: string,
    reply-color: color,
    reactions: [ReactionItem],
    rich: styled-text,     // o texto com links azuis clicáveis (montado no Rust)
    jumbo: [string],       // mensagem só de emoji: desenhados grandes e coloridos
}

export struct VoiceMember {
    id: string,
    name: string,
    avatar: string,
    initials: string,
    color: color,
    speaking: bool,
    muted: bool,
    deafened: bool,
    live: bool,
    is-me: bool,
    camera: bool,   // câmera ligada (a imagem vem de Cameras.lookup)
    srv-muted: bool,     // silenciado por um moderador (ícone vermelho)
    srv-deafened: bool,  // áudio desativado por um moderador
    cam-hidden: bool,    // eu: câmera ligada mas escondida só para mim
}

export struct ChannelItem {
    id: string,
    name: string,
    unread: bool,
    people: [VoiceMember],   // canais de voz: quem está nele (pela presença)
}

export struct FriendItem {
    id: string,        // id da amizade
    user-id: string,
    name: string,
    username: string,
    avatar: string,
    initials: string,
    color: color,
    online: bool,
    activity: string,
    kind: string,      // "friend" | "incoming" | "outgoing" | "blocked"
}

export struct DmItem {
    id: string,        // id da conversa
    user-id: string,
    name: string,
    avatar: string,
    initials: string,
    color: color,
    online: bool,
    activity: string,
    unread: int,
}

// Uma cor do tema no editor de perfil.
export struct ColorSlot {
    label: string,
    hex: string,
    color: color,
}

// Tema pronto (quadradinhos do editor).
export struct ThemeItem {
    primary: color,
    accent: color,
    background: color,
    text: color,
}

// Dados do card de perfil.
// Uma tela ou janela que dá para transmitir.
export struct SourceItem {
    id: string,      // "m:<monitor>" | "w:<janela>"
    name: string,
    thumb: image,
    has-thumb: bool,
}

export struct ProfileCardData {
    id: string,
    name: string,
    username: string,
    initials: string,
    avatar: string,
    banner: string,
    bio: string,
    since: string,
    primary: color,
    accent: color,
    background: color,
    text: color,
    relation: string,  // "me" | "friend" | "incoming" | "outgoing" | "blocked" | "none"
    online: bool,
    activity: string,
    deactivated: bool,
}

// Fotos de perfil e banners já baixadas (cache no Rust, por URL).
// `version` aumenta quando chega uma foto nova: quem usa `lookup` se redesenha.
export global Avatars {
    in property <int> version;
    pure callback lookup(string, int) -> image;
}

// Emoji colorido desenhado pelo Windows (o texto do Slint pinta emoji de uma cor só).
export global Emoji {
    pure callback image(string) -> image;
}

// Último quadro da câmera de cada pessoa (cache no Rust, por id do usuário).
// `version` aumenta a cada quadro novo: os quadradinhos com câmera se redesenham.
export global Cameras {
    in property <int> version;
    pure callback lookup(string, int) -> image;
}

