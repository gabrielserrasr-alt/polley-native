// Paleta igual à do app Electron.
export global Theme {
    in-out property <color> rail: #1e1f22;
    in-out property <color> side: #2b2d31;
    in-out property <color> main: #313338;
    in-out property <color> panel: #232428;
    in-out property <color> hover: #35373c;
    in-out property <color> active: #404249;
    in-out property <color> input: #383a40;
    out property <color> txt: #f2f3f5;
    out property <color> muted: #b5bac1;
    out property <color> faint: #80848e;
    out property <color> brand: #5865f2;
    out property <color> ok: #23a55a;
    out property <color> danger: #da373c;
}

// "Reduzir animações" (Acessibilidade): as animações usam duração 0.
export global Motion {
    in property <bool> reduce;
}

// Busca nas configurações (feita no Rust: o Slint não tem "contém").
export global Prefs {
    pure callback matches(string, string) -> bool;
}

// ------------------------------------------------------------------ peças pequenas

component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <color> tint: Theme.brand;
    callback clicked();
    height: 40px;
    border-radius: 4px;
    background: !root.enabled ? root.tint.darker(40%) : ta.has-hover ? root.tint.darker(15%) : root.tint;
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Text {
        text: root.text;
        color: white;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component Field inherits VerticalLayout {
    in property <string> label;
    in property <bool> password;
    in property <bool> reveal;           // "Mostrar senha" ligado: aparece como texto
    in-out property <string> text;
    callback accepted();
    spacing: 6px;
    Text {
        text: root.label;
        color: Theme.muted;
        font-size: 12px;
        font-weight: 700;
    }
    LineEdit {
        text <=> root.text;
        input-type: root.password && !root.reveal ? InputType.password : InputType.text;
        accepted => { root.accepted(); }
    }
}

component Avatar inherits Rectangle {
    in property <string> initials;
    in property <string> url;      // foto ("" ou ainda baixando = iniciais)
    in property <color> tint: Theme.brand;
    in property <length> size: 40px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.tint;
    Text {
        text: root.initials;
        color: white;
        font-size: root.size * 0.42;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    // A foto já vem recortada em círculo do Rust; enquanto não chega, fica vazia e aparecem as iniciais.
    if root.url != "": Image {
        width: root.size;
        height: root.size;
        source: Avatars.lookup(root.url, Avatars.version);
        image-fit: cover;
    }
}

// ------------------------------------------------------------------ login / cadastro

component AuthScreen inherits Rectangle {
    in-out property <string> error;
    in-out property <string> info;
    in property <bool> busy;
    in-out property <bool> register-mode;
    // "Esqueci minha senha": 1) email → código  2) código + senha nova
    in-out property <bool> forgot-mode;
    in-out property <bool> code-sent;
    in-out property <string> code;
    // "Confirme seu email" depois do cadastro (o Rust liga)
    in-out property <bool> confirm-mode;
    in property <bool> accepted;         // já leu e aceitou os Termos e a Política (nesta vez)
    callback start-accept();             // abre a leitura obrigatória dos documentos
    in-out property <string> email;
    in-out property <string> password;
    in-out property <string> password2;   // "repita a senha nova" (esqueci minha senha)
    in-out property <bool> show-pw;       // "Mostrar senha" (continua ligado ao trocar de campo)
    in-out property <string> username;
    callback login(string, string);
    callback register(string, string, string);
    callback send-reset(string);
    callback reset-password(string, string, string);
    callback leave-forgot();
    callback confirm-signup(string, string);   // email, código
    callback resend-signup(string);

    function go(register: bool, forgot: bool) {
        root.confirm-mode = false;
        if root.forgot-mode && !forgot {
            root.leave-forgot();
        }
        root.register-mode = register;
        root.forgot-mode = forgot;
        root.code-sent = false;
        root.code = "";
        root.password = "";   // a senha de uma tela não aparece na outra
        root.password2 = "";
        root.show-pw = false;
        root.error = "";
        root.info = "";
    }

    function submit() {
        if root.confirm-mode {
            root.confirm-signup(root.email, root.code);
        } else if root.forgot-mode {
            if root.code-sent {
                if root.password != root.password2 {
                    root.info = "";
                    root.error = "As duas senhas não são iguais.";
                } else {
                    root.reset-password(root.email, root.code, root.password);
                }
            } else {
                root.send-reset(root.email);
            }
        } else if root.register-mode {
            // Confere o básico antes de mandar ler os documentos (não faz ler à toa).
            if root.email.is-empty || root.username.is-empty || root.password.character-count < 8 {
                root.info = "";
                root.error = "Preencha o email, o nome de usuário e uma senha com pelo menos 8 caracteres.";
                return;
            }
            if !root.accepted {
                root.error = "";
                root.start-accept();
                return;
            }
            root.register(root.email, root.password, root.username);
        } else {
            root.login(root.email, root.password);
        }
    }

    background: Theme.rail;
    // Engole cliques para não passarem para a tela de baixo.
    TouchArea { }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 440px;
                background: Theme.main;
                border-radius: 8px;
                VerticalLayout {
                    padding: 32px;
                    spacing: 14px;
                    Text {
                        text: root.confirm-mode ? "Confirme seu email" : root.forgot-mode ? "Esqueceu a senha?" : root.register-mode ? "Criar uma conta" : "Que bom te ver de novo!";
                        font-size: 24px;
                        font-weight: 700;
                        color: Theme.txt;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.confirm-mode ? "Digite o código que enviamos para " + root.email + ". Ele vale por 1 hora."
                            : root.forgot-mode
                            ? (root.code-sent ? "Digite o código que chegou no seu email e escolha a senha nova. O código vale por 1 hora e só pode ser usado uma vez." : "Vamos mandar um código para o email da sua conta.")
                            : root.register-mode ? "Bem-vindo ao Polley" : "Estamos muito animados em te ver novamente!";
                        color: Theme.muted;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    if !root.confirm-mode: Field {
                        label: "EMAIL";
                        text <=> root.email;
                        accepted => { root.submit(); }
                    }
                    if root.confirm-mode: Field {
                        label: "CÓDIGO DO EMAIL";
                        text <=> root.code;
                        accepted => { root.submit(); }
                    }
                    if root.register-mode && !root.forgot-mode && !root.confirm-mode: Field {
                        label: "NOME DE USUÁRIO";
                        text <=> root.username;
                        accepted => { root.submit(); }
                    }
                    if root.forgot-mode && root.code-sent: Field {
                        label: "CÓDIGO DO EMAIL";
                        text <=> root.code;
                        accepted => { root.submit(); }
                    }
                    if !root.confirm-mode && (!root.forgot-mode || root.code-sent): Field {
                        label: root.forgot-mode ? "SENHA NOVA" : "SENHA";
                        password: true;
                        reveal: root.show-pw;
                        text <=> root.password;
                        accepted => { root.submit(); }
                    }
                    if root.forgot-mode && root.code-sent: Field {
                        label: "REPITA A SENHA NOVA";
                        password: true;
                        reveal: root.show-pw;
                        text <=> root.password2;
                        accepted => { root.submit(); }
                    }
                    if !root.confirm-mode && (!root.forgot-mode || root.code-sent): CheckBox {
                        text: root.forgot-mode ? "Mostrar senhas" : "Mostrar senha";
                        checked <=> root.show-pw;
                    }
                    if root.register-mode && !root.forgot-mode && !root.confirm-mode: Text {
                        text: "Ao continuar, você vai ler e aceitar os Termos de Uso e a Política de Privacidade.";
                        color: Theme.faint;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    if !root.forgot-mode && !root.register-mode && !root.confirm-mode: Text {
                        text: "Esqueci minha senha";
                        color: #38bdf8;
                        font-size: 13px;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.go(false, true); }
                        }
                    }
                    if root.error != "": Text {
                        text: root.error;
                        color: #f87171;
                        wrap: word-wrap;
                    }
                    if root.info != "": Text {
                        text: root.info;
                        color: #4ade80;
                        wrap: word-wrap;
                    }
                    PrimaryButton {
                        text: root.busy ? "..." : root.confirm-mode ? "Confirmar e entrar" : root.forgot-mode ? (root.code-sent ? "Trocar senha e entrar" : "Enviar código") : root.register-mode ? "Continuar" : "Entrar";
                        enabled: !root.busy;
                        clicked => { root.submit(); }
                    }
                    if root.confirm-mode: HorizontalLayout {
                        spacing: 16px;
                        Text {
                            text: "Voltar para o login";
                            color: #38bdf8;
                            font-size: 13px;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.go(false, false); }
                            }
                        }
                        Text {
                            text: "Reenviar código";
                            color: #38bdf8;
                            font-size: 13px;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.resend-signup(root.email); }
                            }
                        }
                        Rectangle { }
                    }
                    if root.forgot-mode && !root.confirm-mode: HorizontalLayout {
                        spacing: 16px;
                        Text {
                            text: "Voltar para o login";
                            color: #38bdf8;
                            font-size: 13px;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.go(false, false); }
                            }
                        }
                        if root.code-sent: Text {
                            text: "Reenviar código";
                            color: #38bdf8;
                            font-size: 13px;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.send-reset(root.email); }
                            }
                        }
                        Rectangle { }
                    }
                    if !root.forgot-mode && !root.confirm-mode: HorizontalLayout {
                        spacing: 4px;
                        Text {
                            text: root.register-mode ? "Já tem uma conta?" : "Precisando de uma conta?";
                            color: Theme.faint;
                            font-size: 13px;
                        }
                        Text {
                            text: root.register-mode ? "Entrar" : "Registre-se";
                            color: #38bdf8;
                            font-size: 13px;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.go(!root.register-mode, false); }
                            }
                        }
                        Rectangle { }
                    }
                }
            }
        }
    }
}

// ------------------------------------------------------------------ barra de servidores

// Bolinha vermelha com número (não lidas).
component Badge inherits Rectangle {
    in property <int> count;
    height: 18px;
    width: max(18px, num.preferred-width + 10px);
    border-radius: 9px;
    background: Theme.danger;
    num := Text {
        text: root.count > 99 ? "99+" : root.count;
        color: white;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component RailButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;     // ícone do servidor ("" = iniciais)
    in property <bool> selected;
    in property <bool> unread;
    in property <int> badge;
    in property <color> accent: Theme.brand;
    in property <color> label-color: Theme.txt;
    callback clicked();
    width: 72px;
    height: 56px;

    Rectangle {
        x: 0;
        width: 4px;
        height: root.selected ? 40px : ta.has-hover ? 20px : root.unread ? 8px : 0px;
        y: (parent.height - self.height) / 2;
        background: white;
        border-radius: 2px;
        animate height { duration: Motion.reduce ? 0ms : 150ms; }
    }
    Rectangle {
        x: 12px;
        y: 4px;
        width: 48px;
        height: 48px;
        border-radius: root.selected || ta.has-hover ? 16px : 24px;
        animate border-radius { duration: Motion.reduce ? 0ms : 150ms; }
        background: root.selected || ta.has-hover ? root.accent : Theme.main;
        Text {
            text: root.label;
            color: root.selected || ta.has-hover ? white : root.label-color;
            font-size: 16px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.icon != "": Image {
            width: 48px;
            height: 48px;
            source: Avatars.lookup(root.icon, Avatars.version);
            image-fit: cover;
        }
    }
    if root.badge > 0: Badge {
        count: root.badge;
        x: 60px - self.width / 2 - 2px;
        y: 36px;
        border-width: 3px;
        border-color: Theme.rail;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ------------------------------------------------------------------ canais

component SpeakerIcon inherits Path {
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke-width: 2px;
    fill: transparent;
    commands: "M 11 5 L 6 9 L 2 9 L 2 15 L 6 15 L 11 19 Z M 15.5 8.5 A 5 5 0 0 1 15.5 15.5 M 19 5 A 10 10 0 0 1 19 19";
}

// Ícone desenhado, com um risco vermelho por cima quando `crossed` (mutado/ensurdecido).

component Icon inherits Rectangle {
    in property <string> commands;
    in property <color> tint: Theme.muted;
    in property <bool> crossed;
    in property <length> size: 20px;
    width: root.size;
    height: root.size;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.commands;
        stroke: root.crossed ? Theme.danger : root.tint;
        animate stroke { duration: Motion.reduce ? 0ms : 150ms; easing: ease-out; }
        stroke-width: 2px;
        fill: transparent;
    }
    // O traço aparece/some suave (igual ao Discord ao mutar).
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: Icons.slash;
        stroke: Theme.danger;
        stroke-width: 2.5px;
        opacity: root.crossed ? 1 : 0;
        animate opacity { duration: Motion.reduce ? 0ms : 150ms; easing: ease-out; }
    }
}

component ChannelRow inherits Rectangle {
    in property <string> name;
    in property <bool> voice;
    in property <bool> selected;
    in property <bool> unread;
    in property <bool> can-delete;
    callback clicked();
    callback delete();
    height: 34px;
    border-radius: 4px;
    background: root.selected ? Theme.active : ta.has-hover ? Theme.hover : transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            width: 18px;
            if root.voice: SpeakerIcon {
                stroke: root.selected ? Theme.txt : Theme.faint;
            }
            if !root.voice: Text {
                text: "#";
                font-size: 20px;
                color: root.selected ? Theme.txt : Theme.faint;
                horizontal-alignment: center;
            }
        }
        Text {
            text: root.name;
            vertical-alignment: center;
            font-size: 15px;
            font-weight: root.unread && !root.selected ? 700 : 400;
            color: root.selected || ta.has-hover || root.unread ? Theme.txt : Theme.faint;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    // Lixeira por cima da linha (depois do `ta` para receber o clique).
    Rectangle {
        visible: root.can-delete && (ta.has-hover || del-ta.has-hover || root.selected);
        x: parent.width - self.width - 6px;
        y: (parent.height - self.height) / 2;
        width: 22px;
        height: 22px;
        border-radius: 4px;
        background: del-ta.has-hover ? Theme.hover : transparent;
        Icon {
            x: 3px;
            y: 3px;
            commands: Icons.trash;
            tint: del-ta.has-hover ? #f87171 : Theme.faint;
            size: 16px;
        }
        del-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.delete(); }
        }
    }
}

// Título de seção da lista de canais, com "+" para criar (dono/admin).
component ChannelSection inherits Rectangle {
    in property <string> text;
    in property <bool> can-add;
    callback add();
    height: 32px;
    Text {
        x: 0;
        y: parent.height - self.height;
        text: root.text;
        color: Theme.muted;
        font-size: 12px;
        font-weight: 700;
    }
    if root.can-add: Rectangle {
        x: parent.width - self.width - 4px;
        y: parent.height - self.height + 2px;
        width: 20px;
        height: 20px;
        Icon {
            x: 2px;
            y: 2px;
            commands: Icons.plus;
            tint: add-ta.has-hover ? Theme.txt : Theme.muted;
            size: 16px;
        }
        add-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.add(); }
        }
    }
}

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> crossed;
    in property <color> tint: Theme.muted;
    in property <color> hover-bg: Theme.hover;
    out property <bool> has-hover: ta.has-hover;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 4px;
    background: ta.pressed ? root.hover-bg.darker(20%) : ta.has-hover ? root.hover-bg : transparent;
    animate background { duration: Motion.reduce ? 0ms : 120ms; easing: ease-out; }
    Icon {
        commands: root.icon;
        crossed: root.crossed;
        tint: root.tint;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component LiveBadge inherits Rectangle {
    // Largura segue o texto (antes era fixa e o "AO VIVO" ficava espremido).
    width: live-label.preferred-width + 12px;
    height: 18px;
    border-radius: 4px;
    background: Theme.danger;
    live-label := Text {
        text: "AO VIVO";
        color: white;
        font-size: 10px;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Itens do menu do botão direito (estilo Discord).
component MenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> danger;
    in property <bool> enabled: true;
    callback clicked();
    height: 32px;
    border-radius: 3px;
    background: ta.has-hover && root.enabled ? (root.danger ? Theme.danger : Theme.brand) : transparent;
    animate background { duration: Motion.reduce ? 0ms : 80ms; }
    Text {
        x: 8px;
        width: parent.width - 16px;
        text: root.text;
        color: !root.enabled ? Theme.faint : ta.has-hover ? white : root.danger ? Theme.danger : Theme.txt;
        font-size: 14px;
        font-weight: 500;
        vertical-alignment: center;
        overflow: elide;
    }
    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if root.enabled { root.clicked(); } }
    }
}

component MenuCheck inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <bool> danger;
    callback clicked();
    height: 32px;
    border-radius: 3px;
    background: ta.has-hover ? (root.danger ? Theme.danger : Theme.brand) : transparent;
    animate background { duration: Motion.reduce ? 0ms : 80ms; }
    Text {
        x: 8px;
        width: parent.width - 44px;
        text: root.text;
        color: ta.has-hover ? white : root.danger ? Theme.danger : Theme.txt;
        font-size: 14px;
        font-weight: 500;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        x: parent.width - 28px;
        width: 18px;
        height: 18px;
        border-radius: 4px;
        border-width: root.checked ? 0px : 1.5px;
        border-color: ta.has-hover ? white : Theme.muted;
        background: root.checked ? (ta.has-hover ? white : Theme.brand) : transparent;
        animate background { duration: Motion.reduce ? 0ms : 120ms; }
        if root.checked: Text {
            text: "✓";
            color: ta.has-hover ? Theme.brand : white;
            font-size: 13px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component MenuSep inherits Rectangle {
    height: 9px;
    Rectangle {
        x: 6px;
        width: parent.width - 12px;
        height: 1px;
        background: #3f4147;
    }
}

// Pessoa na chamada, na barra lateral (embaixo do canal de voz).
component VoiceMemberRow inherits Rectangle {
    in property <VoiceMember> member;
    callback clicked();
    callback menu(length, length);   // botão direito (posição na janela)
    height: 32px;
    border-radius: 4px;
    background: row-ta.has-hover ? Theme.hover : transparent;
    row-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(ev) => {
            if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    HorizontalLayout {
        padding-left: 30px;
        padding-right: 8px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Avatar {
                size: 24px;
                url: root.member.avatar;
                initials: root.member.initials;
                tint: root.member.color;
                border-width: root.member.speaking ? 2px : 0px;
                border-color: Theme.ok;
            }
        }
        Text {
            text: root.member.name;
            color: root.member.speaking ? Theme.txt : Theme.muted;
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.member.live: VerticalLayout {
            alignment: center;
            LiveBadge { }
        }
        if root.member.muted || root.member.srv-muted: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px + 4px;
                height: 16px + 4px;
                border-radius: 4px;
                // Fundo vermelho = foi um moderador (não dá para desfazer sozinho).
                background: root.member.srv-muted ? Theme.danger.transparentize(60%) : transparent;
                Icon { commands: Icons.mic; crossed: true; size: 16px; }
            }
        }
        if root.member.deafened || root.member.srv-deafened: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px + 4px;
                height: 16px + 4px;
                border-radius: 4px;
                // Fundo vermelho = foi um moderador (não dá para desfazer sozinho).
                background: root.member.srv-deafened ? Theme.danger.transparentize(60%) : transparent;
                Icon { commands: Icons.headphones; crossed: true; size: 16px; }
            }
        }
    }
}

// Bloco de uma pessoa na tela da chamada.
component VoiceTile inherits Rectangle {
    in property <VoiceMember> member;
    // Em destaque: a câmera aparece inteira (sem cortar as bordas).
    in property <bool> big;
    // Mouse fora da chamada: o nome some e ficam só os ícones (mutado etc.).
    in property <bool> show-name: true;
    callback watch();
    callback menu(length, length);
    callback clicked();
    border-radius: 8px;
    background: root.big && root.member.camera ? #000000 : root.member.color.darker(55%);
    border-width: root.member.speaking ? 3px : 0px;
    border-color: Theme.ok;
    clip: true;
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(ev) => {
            if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    if root.member.camera: Image {
        width: parent.width;
        height: parent.height;
        source: Cameras.lookup(root.member.id, Cameras.version);
        image-fit: root.big ? contain : cover;
    }
    // Moldura verde de quem fala por cima da câmera.
    if root.member.camera && root.member.speaking: Rectangle {
        border-radius: 8px;
        border-width: 3px;
        border-color: Theme.ok;
    }
    if !root.member.camera: Avatar {
        size: root.big ? min(120px, root.height * 0.45) : min(80px, root.height * 0.45);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        url: root.member.avatar;
        initials: root.member.initials;
        tint: root.member.color;
    }
    // Minha câmera ligada, mas "Mostrar minha própria câmera" desmarcado.
    if root.member.cam-hidden: Rectangle {
        x: (parent.width - self.width) / 2;
        y: 10px;
        width: hint.preferred-width + 16px;
        height: 24px;
        border-radius: 12px;
        background: #000000a0;
        hint := Text {
            text: "Câmera ligada (escondida só para você)";
            color: white;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
    if root.member.live: LiveBadge {
        x: 10px;
        y: 10px;
    }
    if root.member.live && !root.member.is-me: Rectangle {
        width: 150px;
        height: 36px;
        x: (parent.width - self.width) / 2;
        y: parent.height * 0.5 + min(80px, parent.height * 0.45) / 2 + 12px;
        border-radius: 18px;
        background: watch-ta.has-hover ? Theme.brand.darker(15%) : Theme.brand;
        Text {
            text: "Assistir live";
            color: white;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        watch-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.watch(); }
        }
    }
    if root.member.live && root.member.is-me: Text {
        x: (parent.width - self.width) / 2;
        y: parent.height * 0.5 + min(80px, parent.height * 0.45) / 2 + 12px;
        text: "Você está ao vivo";
        color: white;
        font-weight: 700;
    }
    // nome no canto
    Rectangle {
        visible: root.show-name || root.member.muted || root.member.srv-muted || root.member.deafened || root.member.srv-deafened;
        x: 10px;
        y: parent.height - self.height - 10px;
        height: 26px;
        width: name-row.preferred-width;
        border-radius: 4px;
        background: #000000a0;
        name-row := HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 4px;
            if root.member.muted || root.member.srv-muted: VerticalLayout {
                alignment: center;
                Rectangle {
                width: 14px + 4px;
                height: 14px + 4px;
                border-radius: 4px;
                // Fundo vermelho = foi um moderador (não dá para desfazer sozinho).
                background: root.member.srv-muted ? Theme.danger.transparentize(60%) : transparent;
                Icon { commands: Icons.mic; crossed: true; size: 14px; }
            }
            }
            if root.member.deafened || root.member.srv-deafened: VerticalLayout {
                alignment: center;
                Rectangle {
                width: 14px + 4px;
                height: 14px + 4px;
                border-radius: 4px;
                // Fundo vermelho = foi um moderador (não dá para desfazer sozinho).
                background: root.member.srv-deafened ? Theme.danger.transparentize(60%) : transparent;
                Icon { commands: Icons.headphones; crossed: true; size: 14px; }
            }
            }
            if root.show-name: Text {
                text: root.member.name;
                color: white;
                font-size: 13px;
                vertical-alignment: center;
            }
        }
    }
}

component Choice inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: 36px;
    border-radius: 4px;
    border-width: 2px;
    border-color: root.selected ? Theme.brand : Theme.active;
    background: root.selected ? Theme.brand.transparentize(75%) : ta.has-hover ? Theme.hover : Theme.side;
    Text {
        text: root.text;
        color: root.selected ? Theme.txt : Theme.muted;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Miniatura de uma tela/janela na escolha do que transmitir.
component SourceCard inherits Rectangle {
    in property <SourceItem> item;
    in property <bool> selected;
    callback clicked();
    border-radius: 6px;
    border-width: 2px;
    border-color: root.selected ? Theme.brand : ta.has-hover ? Theme.active : transparent;
    background: root.selected ? Theme.brand.transparentize(80%) : Theme.side;
    VerticalLayout {
        padding: 6px;
        spacing: 6px;
        Rectangle {
            vertical-stretch: 1;
            background: #00000060;
            border-radius: 4px;
            clip: true;
            if root.item.has-thumb: Image {
                width: parent.width;
                height: parent.height;
                source: root.item.thumb;
                image-fit: contain;
            }
            if !root.item.has-thumb: Text {
                text: "sem prévia";
                color: Theme.faint;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.item.name;
            color: root.selected ? Theme.txt : Theme.muted;
            font-size: 12px;
            font-weight: 600;
            overflow: elide;
            horizontal-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component SectionTitle inherits Text {
    color: Theme.muted;
    font-size: 12px;
    font-weight: 700;
    height: 32px;
    vertical-alignment: bottom;
}

// ------------------------------------------------------------------ amigos e DMs

// Avatar com a bolinha de status (verde = online, cinza = offline).
component StatusAvatar inherits Rectangle {
    in property <string> initials;
    in property <string> url;
    in property <color> tint: Theme.brand;
    in property <length> size: 32px;
    in property <bool> online;
    // cor do fundo atrás do avatar (a bolinha "recorta" o avatar com ela)
    in property <color> ring: Theme.side;
    width: root.size;
    height: root.size;
    Avatar {
        size: root.size;
        url: root.url;
        initials: root.initials;
        tint: root.tint;
    }
    Rectangle {
        width: root.size * 0.42;
        height: self.width;
        x: root.size - self.width + 2px;
        y: root.size - self.height + 2px;
        border-radius: self.width / 2;
        background: root.online ? Theme.ok : Theme.faint;
        border-width: 3px;
        border-color: root.ring;
    }
}

// Uma pessoa na coluna de membros (clicar abre o card, com a moderação).
component MemberRow inherits Rectangle {
    in property <MemberItem> m;
    callback clicked();
    height: 42px;
    border-radius: 4px;
    background: ta.has-hover ? Theme.hover : transparent;
    opacity: root.m.online ? 1 : 0.55;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            StatusAvatar {
                size: 32px;
                url: root.m.avatar;
                initials: root.m.initials;
                tint: root.m.color;
                online: root.m.online;
                ring: Theme.side;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.m.name;
                color: root.m.online ? Theme.txt : Theme.muted;
                overflow: elide;
            }
            if root.m.activity != "": Text {
                text: "Jogando " + root.m.activity;
                color: Theme.muted;
                font-size: 12px;
                overflow: elide;
            }
        }
        if root.m.role != "member": Text {
            text: root.m.role == "owner" ? "DONO" : "ADMIN";
            color: root.m.role == "owner" ? #f0b232 : Theme.brand.brighter(30%);
            font-size: 10px;
            font-weight: 800;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Botão da barra embaixo da chamada (estilo Discord). `menu` = setinha ⌄ ao lado (abre opções).
component CallButton inherits Rectangle {
    in property <string> icon;
    in property <bool> crossed;          // mutado/ensurdecido: ícone riscado em vermelho
    in property <bool> on;               // câmera/tela ligada: fundo verde
    in property <bool> danger;           // sair da chamada: fundo vermelho
    in property <bool> menu;
    callback clicked();
    callback menu-clicked();
    height: 48px;
    width: root.menu ? 88px : root.danger ? 72px : 56px;
    border-radius: 12px;
    background: root.danger ? (main-ta.pressed ? Theme.danger.darker(30%) : main-ta.has-hover ? Theme.danger.darker(15%) : Theme.danger)
        : root.on ? (main-ta.pressed ? Theme.ok.darker(30%) : main-ta.has-hover ? Theme.ok.darker(15%) : Theme.ok)
        : #2b2d31;
    animate background { duration: Motion.reduce ? 0ms : 150ms; easing: ease-out; }
    HorizontalLayout {
        Rectangle {
            width: root.danger ? 72px : 56px;
            border-radius: 12px;
            background: root.danger || root.on ? transparent : main-ta.pressed ? #45474e : main-ta.has-hover ? #3a3c42 : transparent;
            animate background { duration: Motion.reduce ? 0ms : 120ms; easing: ease-out; }
            Icon {
                commands: root.icon;
                crossed: root.crossed;
                tint: root.crossed ? #f23f42 : white;
                size: 22px;
            }
            main-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.clicked(); }
            }
        }
        if root.menu: Rectangle {
            border-radius: 12px;
            background: menu-ta.has-hover ? #3a3c42 : transparent;
            animate background { duration: Motion.reduce ? 0ms : 120ms; easing: ease-out; }
            Icon {
                commands: Icons.chevron;
                tint: Theme.muted;
                size: 16px;
            }
            menu-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.menu-clicked(); }
            }
        }
    }
}

// Botão largo do painel "Voz conectada" (câmera, tela), como no Discord.
component PanelButton inherits Rectangle {
    in property <string> icon;
    in property <bool> on;
    in property <bool> busy;
    callback clicked();
    height: 32px;
    horizontal-stretch: 1;
    border-radius: 6px;
    background: root.on ? (ta.has-hover ? Theme.ok.darker(15%) : Theme.ok) : ta.pressed ? #45474e : ta.has-hover ? #3a3c42 : #2b2d31;
    animate background { duration: Motion.reduce ? 0ms : 150ms; easing: ease-out; }
    Icon {
        commands: root.icon;
        tint: root.busy ? Theme.faint : white;
        size: 18px;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Setinha ⌄ ao lado do microfone/fone (abre as opções).
component ChevronButton inherits Rectangle {
    callback clicked();
    width: 16px;
    height: 32px;
    border-radius: 4px;
    background: ta.has-hover ? Theme.hover : transparent;
    animate background { duration: Motion.reduce ? 0ms : 120ms; easing: ease-out; }
    Icon {
        commands: Icons.chevron;
        tint: Theme.muted;
        size: 14px;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component SmallButton inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.active;
    callback clicked();
    height: 30px;
    width: label.preferred-width + 24px;
    border-radius: 4px;
    background: ta.has-hover ? root.tint.brighter(15%) : root.tint;
    label := Text {
        text: root.text;
        color: white;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Anexo de uma mensagem: imagem (clicar abre no navegador) ou cartão com nome, tamanho e "Baixar".
component AttachmentView inherits Rectangle {
    in property <AttachmentItem> att;
    callback open();
    callback save();
    callback play();
    property <image> img: root.att.image ? Avatars.lookup("att:" + root.att.url, Avatars.version) : Avatars.lookup("", 0);
    property <bool> show-img: root.att.image && root.img.width > 0;
    width: root.show-img ? root.img.width * 1px : 360px;
    height: root.show-img ? root.img.height * 1px : 60px;
    border-radius: 6px;
    background: root.show-img ? transparent : Theme.side;
    border-width: root.show-img ? 0px : 1px;
    border-color: Theme.rail;
    clip: true;
    if root.show-img: Image {
        width: parent.width;
        height: parent.height;
        source: root.img;
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.open(); }
        }
    }
    if !root.show-img: HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        Rectangle {
            width: 30px;
            Icon {
                commands: Icons.file;
                tint: Theme.muted;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.att.name;
                color: #00a8fc;
                overflow: elide;
            }
            Text {
                text: root.att.size;
                color: Theme.faint;
                font-size: 12px;
            }
        }
        if root.att.video: VerticalLayout {
            alignment: center;
            SmallButton {
                text: "▶ Assistir";
                tint: Theme.brand;
                clicked => { root.play(); }
            }
        }
        VerticalLayout {
            alignment: center;
            SmallButton {
                text: "Baixar";
                clicked => { root.save(); }
            }
        }
    }
}

// Aba do cabeçalho da página de amigos.
component TabChip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> accent;   // "Adicionar amigo" (verde)
    callback clicked();
    height: 26px;
    width: label.preferred-width + 18px;
    border-radius: 4px;
    background: root.accent ? (root.selected ? transparent : Theme.ok) : root.selected ? Theme.active : ta.has-hover ? Theme.hover : transparent;
    label := Text {
        text: root.text;
        color: root.accent ? (root.selected ? Theme.ok : white) : root.selected || ta.has-hover ? Theme.txt : Theme.muted;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component FriendRow inherits Rectangle {
    in property <FriendItem> f;
    callback profile();
    callback accept();
    callback remove();
    callback block();
    callback message();
    height: 62px;
    border-radius: 8px;
    background: ta.has-hover ? Theme.hover : transparent;
    ta := TouchArea { }
    Rectangle {
        y: 0;
        x: 10px;
        width: parent.width - 20px;
        height: 1px;
        background: Theme.hover;
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            StatusAvatar {
                size: 36px;
                url: root.f.avatar;
                initials: root.f.initials;
                tint: root.f.color;
                online: root.f.online && root.f.kind == "friend";
                ring: ta.has-hover ? Theme.hover : Theme.main;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.profile(); }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.f.name;
                    color: Theme.txt;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: "@" + root.f.username;
                    color: Theme.faint;
                    font-size: 13px;
                    vertical-alignment: center;
                    visible: ta.has-hover;
                }
                Rectangle { }
            }
            Text {
                text: root.f.kind == "friend" ? (root.f.activity != "" ? "Jogando " + root.f.activity : root.f.online ? "Disponível" : "Offline")
                    : root.f.kind == "incoming" ? "Pedido de amizade recebido"
                    : root.f.kind == "outgoing" ? "Pedido de amizade enviado" : "Bloqueado";
                color: Theme.muted;
                font-size: 12px;
            }
        }
        if root.f.kind == "friend": VerticalLayout {
            alignment: center;
            SmallButton { text: "Mensagem"; tint: Theme.brand; clicked => { root.message(); } }
        }
        if root.f.kind == "friend": VerticalLayout {
            alignment: center;
            SmallButton { text: "Remover"; clicked => { root.remove(); } }
        }
        if root.f.kind == "friend": VerticalLayout {
            alignment: center;
            SmallButton { text: "Bloquear"; tint: Theme.danger; clicked => { root.block(); } }
        }
        if root.f.kind == "incoming": VerticalLayout {
            alignment: center;
            SmallButton { text: "Aceitar"; tint: Theme.ok; clicked => { root.accept(); } }
        }
        if root.f.kind == "incoming": VerticalLayout {
            alignment: center;
            SmallButton { text: "Recusar"; clicked => { root.remove(); } }
        }
        if root.f.kind == "outgoing": VerticalLayout {
            alignment: center;
            SmallButton { text: "Cancelar"; clicked => { root.remove(); } }
        }
        if root.f.kind == "blocked": VerticalLayout {
            alignment: center;
            SmallButton { text: "Desbloquear"; clicked => { root.remove(); } }
        }
    }
}

component FriendsPage inherits Rectangle {
    in property <[FriendItem]> friends;
    in property <string> tab;
    in property <string> result;
    in property <bool> ok;
    in property <int> online-count;
    in property <int> friend-count;
    in property <int> pending-total;
    in property <int> blocked-count;
    callback add(string);
    callback accept(string);
    callback remove(string);
    callback block(string);
    callback message(string);
    callback profile(string);
    background: Theme.main;
    TouchArea { }

    if root.tab == "add": VerticalLayout {
        padding: 24px;
        spacing: 10px;
        alignment: start;
        Text {
            text: "ADICIONAR AMIGO";
            color: Theme.txt;
            font-weight: 700;
        }
        Text {
            text: "Você pode adicionar amigos com o nome de usuário deles no Polley.";
            color: Theme.muted;
            font-size: 14px;
        }
        HorizontalLayout {
            spacing: 8px;
            add-input := LineEdit {
                placeholder-text: "Digite um nome de usuário, ex.: jovempromissorx";
                accepted(text) => { root.add(text); }
            }
            PrimaryButton {
                width: 190px;
                text: "Enviar pedido de amizade";
                clicked => { root.add(add-input.text); }
            }
        }
        if root.result != "": Text {
            text: root.result;
            color: root.ok ? #4ade80 : #f87171;
            wrap: word-wrap;
        }
    }

    if root.tab != "add": Flickable {
        VerticalLayout {
            padding: 16px;
            alignment: start;
            SectionTitle {
                text: root.tab == "online" ? "DISPONÍVEL — " + root.online-count
                    : root.tab == "all" ? "TODOS OS AMIGOS — " + root.friend-count
                    : root.tab == "pending" ? "PENDENTE — " + root.pending-total
                    : "BLOQUEADO — " + root.blocked-count;
            }
            Rectangle { height: 8px; }
            // `for` não aceita `if` direto: cada item fica num layout que some quando está vazio.
            for f in root.friends: VerticalLayout {
                if (root.tab == "online" && f.kind == "friend" && f.online)
                    || (root.tab == "all" && f.kind == "friend")
                    || (root.tab == "pending" && (f.kind == "incoming" || f.kind == "outgoing"))
                    || (root.tab == "blocked" && f.kind == "blocked"): FriendRow {
                    f: f;
                    profile => { root.profile(f.user-id); }
                    accept => { root.accept(f.id); }
                    remove => { root.remove(f.id); }
                    block => { root.block(f.user-id); }
                    message => { root.message(f.user-id); }
                }
            }
            if (root.tab == "online" && root.online-count == 0) || (root.tab == "all" && root.friend-count == 0)
                || (root.tab == "pending" && root.pending-total == 0) || (root.tab == "blocked" && root.blocked-count == 0): Text {
                text: root.tab == "online" ? "Nenhum amigo disponível agora."
                    : root.tab == "all" ? "Você ainda não tem amigos por aqui. Clique em \"Adicionar amigo\"!"
                    : root.tab == "pending" ? "Nenhum pedido pendente."
                    : "Você não bloqueou ninguém.";
                color: Theme.faint;
                horizontal-alignment: center;
                height: 120px;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}

// Conversa na lista de mensagens diretas.
component DmRow inherits Rectangle {
    in property <DmItem> dm;
    in property <bool> selected;
    callback clicked();
    height: 42px;
    border-radius: 4px;
    background: root.selected ? Theme.active : ta.has-hover ? Theme.hover : transparent;
    HorizontalLayout {
        padding-left: 8px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            StatusAvatar {
                size: 30px;
                url: root.dm.avatar;
                initials: root.dm.initials;
                tint: root.dm.color;
                online: root.dm.online;
                ring: root.selected ? Theme.active : ta.has-hover ? Theme.hover : Theme.side;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.dm.name;
                color: root.selected || ta.has-hover || root.dm.unread > 0 ? Theme.txt : Theme.muted;
                font-weight: root.dm.unread > 0 ? 700 : 400;
                overflow: elide;
            }
            if root.dm.activity != "": Text {
                text: "Jogando " + root.dm.activity;
                color: Theme.faint;
                font-size: 11px;
                overflow: elide;
            }
        }
        if root.dm.unread > 0: VerticalLayout {
            alignment: center;
            padding-right: 8px;
            Badge { count: root.dm.unread; }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ------------------------------------------------------------------ perfil

// Card de perfil pintado com o tema da pessoa (popup e pré-visualização do editor).
// Botões de ação entram no fim, como filhos: ProfileCard { ... PrimaryButton { } }
component ProfileCard inherits Rectangle {
    in property <string> name;
    in property <string> username;
    in property <string> initials;
    in property <string> avatar;
    in property <string> banner;
    in property <string> bio;
    in property <string> since;
    in property <color> primary: Theme.brand;
    in property <color> accent: #eb459e;
    in property <color> card-bg: Theme.panel;
    in property <color> card-text: Theme.txt;
    in property <bool> online;
    in property <bool> show-status;
    in property <string> activity;
    in property <bool> deactivated;
    height: col.preferred-height + 8px;
    border-radius: 10px;
    background: @linear-gradient(180deg, root.primary 0%, root.card-bg 55%, root.accent.transparentize(75%) 100%);
    Rectangle {
        x: 4px;
        y: 4px;
        width: parent.width - 8px;
        height: parent.height - 8px;
        border-radius: 8px;
        clip: true;
        background: root.card-bg.transparentize(7%);
        col := VerticalLayout {
            // banner
            Rectangle {
                height: 118px;
                background: root.primary;
                if root.banner != "": Image {
                    width: parent.width;
                    height: parent.height;
                    source: Avatars.lookup("banner:" + root.banner, Avatars.version);
                    image-fit: cover;
                }
            }
            // foto por cima do banner
            Rectangle {
                height: 50px;
                Rectangle {
                    x: 14px;
                    y: -46px;
                    width: 96px;
                    height: 96px;
                    border-radius: 48px;
                    background: root.card-bg;
                    Avatar {
                        x: 6px;
                        y: 6px;
                        size: 84px;
                        url: root.avatar;
                        initials: root.initials;
                        tint: root.primary;
                    }
                    if root.show-status: Rectangle {
                        x: 66px;
                        y: 66px;
                        width: 26px;
                        height: 26px;
                        border-radius: 13px;
                        border-width: 5px;
                        border-color: root.card-bg;
                        background: root.online ? Theme.ok : Theme.faint;
                    }
                }
            }
            VerticalLayout {
                padding: 16px;
                padding-top: 0px;
                spacing: 4px;
                Text {
                    text: root.name;
                    color: root.card-text;
                    font-size: 20px;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: "@" + root.username;
                    color: root.card-text.transparentize(25%);
                    font-size: 13px;
                }
                if root.activity != "": Text {
                    text: "🎮 Jogando " + root.activity;
                    color: root.card-text;
                    font-size: 13px;
                    font-weight: 600;
                }
                if root.deactivated: Text {
                    text: "Esta conta está desativada.";
                    color: root.card-text.transparentize(30%);
                    font-size: 13px;
                }
                if root.bio != "": VerticalLayout {
                    spacing: 4px;
                    Rectangle { height: 8px; }
                    Rectangle { height: 1px; background: root.card-text.transparentize(80%); }
                    Rectangle { height: 6px; }
                    Text {
                        text: "SOBRE MIM";
                        color: root.card-text.transparentize(20%);
                        font-size: 11px;
                        font-weight: 700;
                    }
                    Text {
                        text: root.bio;
                        color: root.card-text;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                }
                Rectangle { height: 8px; }
                Rectangle { height: 1px; background: root.card-text.transparentize(80%); }
                Rectangle { height: 6px; }
                Text {
                    text: "MEMBRO DO POLLEY DESDE";
                    color: root.card-text.transparentize(20%);
                    font-size: 11px;
                    font-weight: 700;
                }
                Text {
                    text: root.since;
                    color: root.card-text;
                    font-size: 13px;
                }
                @children
            }
        }
    }
}

// Botão pequeno com contorno (editor de perfil).
component GhostButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    height: 32px;
    width: label.preferred-width + 24px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.active;
    background: ta.has-hover && root.enabled ? Theme.hover : transparent;
    opacity: root.enabled ? 1 : 0.5;
    label := Text {
        text: root.text;
        color: Theme.txt;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Quadradinho de um tema pronto (principal em cima, destaque embaixo).
component PresetSwatch inherits Rectangle {
    in property <ThemeItem> t;
    callback clicked();
    width: 44px;
    height: 44px;
    border-radius: 8px;
    border-width: ta.has-hover ? 2px : 1px;
    border-color: ta.has-hover ? Theme.txt : Theme.active;
    background: @linear-gradient(135deg, root.t.primary 0%, root.t.primary 50%, root.t.accent 50%, root.t.accent 100%);
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Uma cor do tema: amostra + nome + código (#rrggbb, Enter aplica).
component ColorRow inherits HorizontalLayout {
    in property <ColorSlot> slot;
    callback changed(string);
    spacing: 10px;
    height: 36px;
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 28px;
            height: 28px;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.active;
            background: root.slot.color;
        }
    }
    Text {
        text: root.slot.label;
        color: Theme.muted;
        font-size: 13px;
        vertical-alignment: center;
        width: 120px;
    }
    changed slot => { hex.text = root.slot.hex; }
    hex := LineEdit {
        text: root.slot.hex;
        width: 110px;
        // Inválido: o Rust ignora e o campo volta a mostrar a cor atual.
        accepted(text) => {
            root.changed(text);
            self.text = root.slot.hex;
        }
    }
}

// Botão "Gravar" da faixa AO VIVO: vira "■ 00:12" (vermelho) enquanto grava.
component RecordButton inherits Rectangle {
    in property <bool> recording;
    in property <string> time;
    callback clicked();
    height: 28px;
    width: 84px;   // fixo: cabe "Gravar" e "1:02:03" sem a barra lateral apertar
    border-radius: 14px;
    background: root.recording ? (ta.has-hover ? Theme.danger.darker(15%) : Theme.danger) : ta.has-hover ? Theme.active : Theme.hover;
    HorizontalLayout {
        spacing: 6px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: root.recording ? 2px : 5px;   // ● gravar / ■ parar
                background: root.recording ? white : Theme.danger;
            }
        }
        Text {
            text: root.recording ? root.time : "Gravar";
            color: white;
            font-size: 12px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ------------------------------------------------------------------ janela principal

export component AppWindow inherits Window {
    title: "Polley";
    icon: @image-url("../assets/icon.png");
    preferred-width: 1200px;
    preferred-height: 760px;
    min-width: 900px;
    min-height: 560px;
    background: Theme.main;
    // "Tamanho do texto" (Acessibilidade): mensagens, nomes e tudo que não tem tamanho fixo.
    default-font-size: root.pref-chat-font * 1px;

    // estado geral
    in property <bool> ready;
    in property <bool> logged-in;
    in property <string> ram;

    // atualização automática (o Rust preenche quando a versão nova já está baixada e conferida)
    in property <string> update-version;         // "" = nenhuma
    in property <string> update-notes;
    in-out property <bool> update-later;         // clicou em "Depois" (volta ao reabrir o app)
    callback install-update();

    // login
    in-out property <string> auth-error;
    in-out property <string> auth-info;
    in property <bool> auth-busy;
    in-out property <bool> auth-code-sent;       // "Esqueci minha senha": código já enviado
    callback login(string, string);
    callback register(string, string, string);
    callback send-reset(string);                 // email
    callback reset-password(string, string, string); // email, código, senha nova
    callback leave-forgot();                     // voltou para o login sem terminar
    in-out property <bool> auth-confirm;         // tela "Confirme seu email" (código do cadastro)
    // Termos de Uso / Política de Privacidade (janela de leitura)
    in-out property <bool> legal-open;
    // Cadastro: ler os Termos (passo 0) e a Política (passo 1) até o fim e aceitar.
    in-out property <bool> legal-accept-flow;
    in-out property <int> legal-step;
    in-out property <bool> legal-read;           // já rolou até o fim do documento aberto
    in-out property <bool> legal-age;            // marcou "tenho 13 anos ou mais"
    in-out property <bool> legal-accepted;       // aceitou (vale até fechar o app)
    in-out property <string> auth-email;
    in-out property <string> auth-password;
    in-out property <string> auth-username;
    in property <string> legal-title;
    in property <[LegalBlock]> legal-blocks;
    callback open-legal(string);                 // "termos" | "privacidade"
    callback confirm-signup(string, string);     // email, código
    callback resend-signup(string);              // email

    // Configurações → Minha conta
    // teste de microfone
    in property <bool> mic-testing;
    in property <float> mic-level;               // 0 a 1
    in property <bool> mic-monitor;              // ouvindo o próprio microfone
    in property <bool> mic-feedback;             // microfonia detectada
    callback start-mic-test(int, int);           // microfone, saída (índices da lista)
    callback stop-mic-test();
    callback set-mic-monitor(bool);
    changed settings-open => {
        if !self.settings-open && self.mic-testing {
            root.stop-mic-test();
        }
    }
    // Categoria aberta nas configurações (ids da settings-nav). Começa em "Minha conta", igual ao Discord.
    in-out property <string> settings-tab: "account";
    // Configurações → Atalhos
    in property <bool> keys-ptt;                 // "Apertar para falar" ligado
    in property <string> keys-ptt-name;          // "Mouse 4", "V"... ("" = nenhuma)
    in property <string> keys-mute-name;         // "Ctrl + Shift + M" ("" = nenhum)
    in property <string> keys-deafen-name;
    in property <string> keys-capturing;         // "ptt" | "mute" | "deafen" = esperando a tecla
    callback capture-key(string);
    callback clear-key(string);
    callback set-push-to-talk(bool);
    in property <bool> keys-sounds;              // sons ao mutar/entrar/sair
    // aba "Windows"
    in property <bool> win-autostart;
    in property <bool> win-can-autostart;        // só no Polley instalado (não na versão de teste)
    in property <bool> win-tray;
    in property <bool> win-minimized;
    callback set-windows-option(string, bool);   // "autostart" | "tray" | "minimized"
    callback set-call-sounds(bool);
    in property <bool> account-busy;
    in-out property <string> account-error;
    in-out property <string> account-info;
    in-out property <string> acc-current;
    in-out property <string> acc-new;
    in-out property <string> acc-confirm;
    in-out property <string> acc-delete-password;
    in-out property <bool> acc-delete-step;      // clicou em "Excluir conta": pede a senha
    in-out property <bool> show-passwords;       // "Mostrar senhas" em Minha conta
    callback change-password(string, string, string); // atual, nova, confirmar
    callback delete-account(string);             // senha
    public function clear-password-fields() {
        root.acc-current = "";
        root.acc-new = "";
        root.acc-confirm = "";
        root.acc-delete-password = "";
        root.acc-delete-step = false;
        root.show-passwords = false;
        root.account-error = "";
        root.account-info = "";
    }

    // eu
    in property <string> me-name;
    in property <string> me-username;
    in property <string> me-initials;
    in property <color> me-color: Theme.brand;
    in property <string> me-avatar;
    callback logout();

    // perfil: card (clicar em alguém) e editor
    in-out property <bool> card-open;
    in property <ProfileCardData> card;
    in property <string> card-message;
    callback show-profile(string);          // "" = eu
    callback card-add-friend(string, string);
    in-out property <bool> profile-open;
    in-out property <string> edit-name;
    in-out property <string> edit-bio;
    in property <string> edit-username;
    in property <string> edit-since;
    in property <string> edit-avatar;
    in property <string> edit-banner;
    in property <[ColorSlot]> edit-slots;
    in property <[ThemeItem]> presets;
    in-out property <bool> palette-banner: true;
    in property <string> profile-busy;      // "" = parado; senão, o que está fazendo
    in property <string> profile-error;
    callback open-profile();
    callback pick-image(string, bool);      // "avatar" | "banner" | "palette", usar como banner
    callback remove-images();
    callback apply-preset(int);
    callback set-color(int, string);
    callback save-profile(string, string);

    // servidores
    in property <[ServerItem]> servers;
    in property <string> current-server;
    in property <string> server-name;
    in property <string> invite-code;
    // janela "Configurações do servidor"
    in-out property <bool> srv-edit-open;
    in-out property <string> srv-edit-name;
    in property <string> srv-edit-icon;
    in property <string> srv-edit-initials;
    in property <string> srv-edit-error;
    in property <bool> srv-edit-busy;
    callback open-server-settings();
    callback pick-server-icon();
    callback remove-server-icon();
    callback save-server(string);
    callback new-invite();
    callback select-server(string);
    callback go-home();

    // gerenciar o servidor aberto
    in property <string> my-role;            // "owner" | "admin" | "member"
    out property <bool> can-manage: root.my-role == "owner" || root.my-role == "admin";
    // membros e moderação
    in property <[MemberItem]> members;
    in-out property <bool> members-open: true;
    in property <string> card-role;              // papel de quem está no card, no servidor aberto ("" = não é membro)
    // Dono modera todos (menos ele); admin só membros comuns. O banco confere de novo.
    out property <bool> card-can-moderate: root.current-server != "" && root.card-role != "" && root.card-role != "owner"
        && root.card.relation != "me" && (root.my-role == "owner" || (root.my-role == "admin" && root.card-role == "member"));
    in property <[BanItem]> bans;
    in-out property <bool> bans-open;
    callback open-bans();
    in-out property <string> notice;             // aviso rápido ("Você foi removido de X", erros)
    // Menu do botão direito numa pessoa da chamada (o Rust preenche e abre)
    in-out property <bool> um-open;
    in property <string> um-id;
    in property <string> um-name;
    in property <bool> um-me;
    in property <string> um-relation;        // "friend" | "incoming" | "outgoing" | "blocked" | "none"
    in property <bool> um-can-mod;
    in property <bool> um-muted;             // silenciado só para mim
    in property <bool> um-hide-cam;          // câmera dele escondida
    in property <bool> um-srv-muted;         // silenciado pelo servidor
    in property <bool> um-srv-deafened;      // áudio desativado pelo servidor
    in property <length> um-x;
    in property <length> um-y;
    in-out property <float> vol-value: 100;
    in property <bool> show-no-video: true;
    in property <bool> show-own-camera: true;
    callback open-user-menu(string, string, length, length);
    callback set-user-volume(string, float);
    callback user-menu(string, string);      // ação, id
    in-out property <bool> server-menu-open;
    in-out property <bool> channel-modal-open;
    in-out property <bool> channel-modal-voice;
    in-out property <string> channel-error;
    callback create-channel(string, bool);
    callback delete-channel(string);
    callback leave-server();
    callback delete-server();
    // confirmação ("Tem certeza?") para ações sem volta
    in-out property <bool> confirm-open;
    in-out property <string> confirm-title;
    in-out property <string> confirm-body;
    in-out property <string> confirm-button;
    in-out property <string> confirm-action; // "leave-server" | "delete-server" | "delete-channel:<id>"
    function ask(action: string, title: string, body: string, button: string) {
        root.confirm-action = action;
        root.confirm-title = title;
        root.confirm-body = body;
        root.confirm-button = button;
        root.server-menu-open = false;
        root.confirm-open = true;
    }
    function open-channel-modal(voice: bool) {
        root.channel-modal-voice = voice;
        root.channel-error = "";
        root.server-menu-open = false;
        root.channel-modal-open = true;
    }

    // canais
    in property <[ChannelItem]> text-channels;
    in property <[ChannelItem]> voice-channels;
    in property <string> current-channel;
    in property <string> channel-name;
    in property <bool> channel-is-voice;
    callback select-channel(string, bool);

    // chamada de voz
    in property <string> voice-channel;         // id do canal conectado ("" = fora da call)
    in property <string> voice-channel-name;
    in property <string> voice-server-name;
    in property <bool> voice-connecting;
    in property <string> voice-error;
    in property <bool> voice-muted;
    in property <bool> voice-deafened;
    in property <[VoiceMember]> voice-members;
    // Pessoa em destaque (clicou no quadradinho): ela grande e as outras numa fileira embaixo.
    in property <string> voice-focus;
    in property <VoiceMember> voice-focus-member;
    in property <[VoiceMember]> voice-others;
    callback focus-member(string);
    // Tamanho dos quadradinhos na tela (o Rust reduz a câmera para esse tamanho, sem borrar).
    in-out property <length> cam-tile-w: 640px;
    in-out property <length> cam-tile-h: 360px;
    in-out property <length> cam-big-w: 1280px;
    in-out property <length> cam-big-h: 720px;
    in property <bool> camera-hq;
    // Chamada em tela cheia: mouse parado há uns segundos = botões somem.
    in property <bool> call-idle;
    // ---- configurações (tela cheia)
    in property <string> app-version;
    in-out property <string> settings-search;
    out property <[SettingsNav]> settings-nav: [
        { head: true, label: "CONFIGURAÇÕES DE USUÁRIO" },
        { id: "account", label: "Minha conta" },
        { id: "security", label: "Senha e segurança" },
        { id: "privacy", label: "Dados e privacidade" },
        { id: "notifications", label: "Notificações" },
        { head: true, label: "CONFIGURAÇÕES DO APLICATIVO" },
        { id: "voice", label: "Voz e vídeo" },
        { id: "appearance", label: "Aparência" },
        { id: "accessibility", label: "Acessibilidade" },
        { id: "windows", label: "Sistema" },
        { id: "language", label: "Idioma e horário" },
        { id: "keys", label: "Atalhos de teclado" },
        { head: true, label: "JOGOS E ATIVIDADE" },
        { id: "games", label: "Jogos registrados" },
        { id: "activity", label: "Privacidade nas atividades" },
        { head: true, label: "AVANÇADO" },
        { id: "developer", label: "Desenvolvedor" },
    ];
    out property <string> settings-title:
        root.settings-tab == "account" ? "Minha conta" : root.settings-tab == "security" ? "Senha e segurança"
        : root.settings-tab == "privacy" ? "Dados e privacidade" : root.settings-tab == "notifications" ? "Notificações"
        : root.settings-tab == "voice" ? "Voz e vídeo" : root.settings-tab == "appearance" ? "Aparência"
        : root.settings-tab == "accessibility" ? "Acessibilidade" : root.settings-tab == "windows" ? "Sistema"
        : root.settings-tab == "language" ? "Idioma e horário" : root.settings-tab == "keys" ? "Atalhos de teclado"
        : root.settings-tab == "games" ? "Jogos registrados" : root.settings-tab == "activity" ? "Privacidade nas atividades"
        : "Desenvolvedor";
    in property <bool> pref-notif-sound: true;
    in property <bool> pref-notif-flash: true;
    in property <bool> pref-notif-popup: true;
    in property <bool> pref-notif-badge: true;
    in property <string> pref-theme: "dark";
    in property <bool> pref-compact;
    in property <int> pref-chat-font: 15;
    in property <bool> pref-reduce-motion;
    in property <bool> pref-clock24: true;
    in property <bool> pref-dev;
    in property <bool> pref-share-activity: true;
    callback set-pref(string, string);
    in property <string> acc-username;
    in property <string> acc-display;
    in property <string> acc-email;
    in property <string> acc-email-masked;
    in-out property <bool> acc-show-email;
    in-out property <bool> acc-deactivate-step;
    callback deactivate-account();
    callback logout-all();
    in property <bool> priv-everyone: true;
    in property <bool> priv-fof: true;
    in property <bool> priv-servers: true;
    callback set-privacy(string, bool);
    in property <bool> mfa-enabled;
    in-out property <bool> mfa-setup;
    in property <bool> mfa-busy;
    in property <image> mfa-qr;
    in property <string> mfa-secret;
    in property <string> mfa-error;
    in property <string> mfa-info;
    in-out property <string> mfa-code;
    callback mfa-start();
    callback mfa-confirm(string);
    callback mfa-disable(string);
    in-out property <bool> auth-mfa-mode;
    in-out property <string> auth-code;
    callback verify-login-mfa(string);
    in property <string> game-now;
    in property <[GameItem]> games-added;
    in property <[string]> games-running;
    in-out property <int> game-pick;
    in-out property <string> game-name;
    callback add-game(int, string);
    callback remove-game(string);
    callback refresh-games();
    callback copy-id(string);
    // Onde a live aparece (o Rust encaixa ali a janelinha da placa de vídeo).
    in-out property <bool> theater-bar;       // barra de cima da tela cheia aparecendo
    out property <bool> video-covered: root.settings-open || root.incoming-dm != "" || root.viewer-open || root.golive-open
        || root.card-open || root.profile-open || (root.server-menu-open && root.current-server != "") || root.srv-edit-open
        || root.channel-modal-open || root.bans-open || root.confirm-open || root.add-open || root.legal-open
        || root.um-open || root.picker-open || !root.logged-in;
    out property <bool> video-visible: root.watching != "" && !root.video-covered
        && (root.theater || (root.voice-channel == root.current-channel
            && (root.channel-is-voice || (root.chat-is-dm && root.show-call))));
    out property <length> video-x: root.theater ? 0px : 72px + root.side-width + 16px;
    out property <length> video-y: root.theater ? (root.theater-bar ? 56px : 0px) : 48px + 16px + 44px;
    out property <length> video-w: root.theater ? root.width : root.width - 72px - root.side-width - 32px;
    out property <length> video-h: root.theater ? root.height - (root.theater-bar ? 56px : 0px) : root.height - 48px - 72px - 32px - 44px;
    callback join-voice(string);
    callback leave-voice();
    callback toggle-mute();
    callback toggle-deafen();

    // transmitir (Go Live) / assistir
    // janela "Voz e vídeo"
    in-out property <bool> settings-open;
    in property <bool> settings-loading;
    in property <[string]> settings-mics;
    in property <[string]> settings-speakers;
    in property <[string]> settings-cameras;
    in-out property <int> settings-mic;
    in-out property <int> settings-speaker;
    in-out property <int> settings-camera;
    in-out property <bool> settings-noise;
    callback open-settings();
    callback save-settings(int, int, int, bool);
    in property <bool> camera-on;
    in property <string> voice-ping;             // "28 ms" ("" = sem medida ainda)
    in property <int> voice-ping-level;          // 0 bom (verde), 1 médio (amarelo), 2 ruim (vermelho)
    // coluna de canais: arrastar a borda muda a largura (fica salva)
    in-out property <length> side-width: 240px;
    callback save-side-width(int);
    function open-voice-settings(tab: string) {
        root.settings-tab = tab;
        root.settings-search = "";
        root.clear-password-fields();
        root.open-settings();
    }
    in property <bool> camera-busy;
    callback toggle-camera();
    in property <bool> screen-live;
    in property <bool> screen-busy;
    in property <string> screen-info;
    in property <string> screen-error;
    in-out property <bool> golive-open;
    in-out property <int> golive-height: 1080;
    in-out property <int> golive-fps: 60;
    in-out property <bool> golive-audio: true;
    in property <[SourceItem]> golive-screens;
    in property <[SourceItem]> golive-windows;
    in property <bool> golive-loading;
    in-out property <string> golive-source;        // id escolhido
    in-out property <bool> golive-source-window;   // o escolhido é uma janela
    in-out property <bool> golive-tab-windows;     // aba "Janelas"
    callback open-golive();
    callback close-golive();
    callback start-screen(string, int, int, bool); // fonte, altura, fps, som
    callback stop-screen();
    // gravar a live (.mp4 em Vídeos\Polley)
    in property <bool> recording;
    in property <string> record-time;        // "00:12"
    in-out property <string> record-message; // "Gravação salva..." / erro (o X fecha)
    in property <string> last-recording;     // caminho do último arquivo
    callback toggle-record();
    callback show-recording(string);
    in property <string> watching;             // id de quem estou assistindo ("" = ninguém)
    in property <string> watching-name;
    in property <image> stream-frame;
    // Área aproximada da live em pixels lógicos (o Rust reduz o vídeo para este tamanho).
    // (janela - barra de servidores - barra de canais - margens) x (janela - cabeçalho - margens)
    out property <length> viewer-width: root.theater ? root.width : root.width - 72px - root.side-width - 32px;
    out property <length> viewer-height: root.theater ? root.height : root.height - 48px - 32px - 72px; // 72 = barra da chamada
    // Tela cheia da live (o Rust também põe a janela do Windows em tela cheia).
    in-out property <bool> theater;
    callback set-fullscreen(bool);
    function toggle-theater() {
        root.theater = !root.theater;
        root.set-fullscreen(root.theater);
    }
    in property <string> watch-info;
    callback watch(string);
    callback stop-watching();

    // amigos / DMs
    in property <[FriendItem]> friends;
    in property <[DmItem]> dms;
    in property <int> pending-count;     // pedidos recebidos (bolinha vermelha)
    in property <int> online-count;
    in property <int> friend-count;
    in property <int> pending-total;
    in property <int> blocked-count;
    in-out property <string> friends-tab: "online";
    in property <string> friend-result;
    in property <bool> friend-ok;
    in property <bool> chat-is-dm;
    in property <int> home-unread;               // DMs não lidas (bolinha no botão de início)
    // ligar pela DM
    in-out property <bool> show-call: true;      // na DM em chamada: mostra a chamada (senão, só o chat)
    callback call-dm(string);
    in property <string> incoming-dm;           // DM que está me ligando ("" = ninguém)
    in property <string> incoming-name;
    in property <string> incoming-avatar;
    in property <string> incoming-initials;
    in property <color> incoming-color;
    callback answer-call(string);
    callback decline-call();
    callback add-friend(string);
    callback accept-friend(string);
    callback remove-friend(string);
    callback block-user(string);
    callback message-user(string);
    callback open-dm(string);

    // mensagens
    in property <[MessageItem]> messages;
    in-out property <string> chat-error;
    callback send-message(string, string);       // texto, id da mensagem respondida ("" = nenhuma)
    // anexos esperando o Enter
    in property <[string]> pending-files;
    in property <bool> chat-sending;
    callback pick-files();
    callback remove-pending(int);
    callback open-attachment(string);
    // ver imagem / vídeo dentro do app
    in-out property <bool> viewer-open;
    in property <image> viewer-image;
    in property <string> viewer-status;          // "Carregando..." / erro ("" = imagem pronta)
    in property <string> viewer-url;
    in property <string> viewer-name;
    callback view-image(string, string);         // url, nome
    callback play-video(string, string);
    callback close-viewer();
    callback save-attachment(string, string);   // url, nome
    // editar / apagar
    in-out property <string> editing-id;         // "" = escrevendo mensagem nova
    in-out property <string> replying-id;        // respondendo a esta mensagem ("" = não)
    in-out property <string> replying-name;
    in property <[string]> emoji-list;           // emojis do seletor
    in-out property <bool> picker-open;
    in-out property <string> picker-for;         // id da mensagem (reagir) ou "" (colocar no texto)
    callback react(string, string);              // mensagem, emoji
    function open-link(url: string) {
        root.ask("open-link:" + url, "Você está saindo do Polley",
            "Este link vai abrir no seu navegador:\n\n" + url + "\n\nSó abra se confiar em quem mandou.", "Abrir site");
    }
    in-out property <string> composer-text;
    callback edit-message(string, string);       // id, texto novo
    callback confirmed(string);                  // ação confirmada no aviso ("delete-message:<id>" etc.)
    // "fulano está digitando..." e mensagens antigas
    in property <string> typing-text;
    in property <bool> chat-has-more;
    in property <bool> chat-loading-older;
    callback typing();
    callback load-older();
    property <length> chat-saved-bottom;
    // Antes de pôr mensagens antigas em cima: lembra a distância até o fim...
    public function chat-remember() {
        root.chat-saved-bottom = chat-list.content-height + chat-list.content-y;
    }
    // ...e depois volta para ela (o que estava na tela continua no mesmo lugar).
    public function chat-restore() {
        chat-list.content-y = min(0px, root.chat-saved-bottom - chat-list.content-height);
    }

    // adicionar servidor
    in-out property <bool> add-open;
    in property <string> add-error;
    callback create-server(string);
    callback join-server(string);

    // Chamado pelo Rust depois de chegar mensagem nova.
    public function scroll-to-bottom() {
        chat-list.content-y = min(0px, chat-list.visible-height - chat-list.content-height);
    }

    // ---------------- tela principal (sempre existe; fica invisível até logar)
    HorizontalLayout {
        visible: root.logged-in;

        // barra de servidores
        Rectangle {
            width: root.theater ? 0px : 72px;
            visible: !root.theater;
            background: Theme.rail;
            VerticalLayout {
                padding-top: 8px;
                spacing: 0px;
                RailButton {
                    label: "P";
                    badge: root.home-unread;
                    selected: root.current-server == "";
                    clicked => { root.go-home(); }
                }
                Rectangle {
                    height: 10px;
                    Rectangle {
                        width: 32px;
                        height: 2px;
                        background: Theme.hover;
                    }
                }
                for s in root.servers: RailButton {
                    label: s.initials;
                    icon: s.icon;
                    unread: s.unread;
                    badge: s.mentions;
                    selected: root.current-server == s.id;
                    clicked => { root.select-server(s.id); }
                }
                RailButton {
                    label: "+";
                    label-color: Theme.ok;
                    accent: Theme.ok;
                    clicked => { root.add-open = true; }
                }
                Rectangle { }
            }
        }

        // barra lateral (canais) + usuário
        Rectangle {
            width: root.theater ? 0px : root.side-width;
            visible: !root.theater;
            background: Theme.side;
            VerticalLayout {
                // cabeçalho
                Rectangle {
                    height: 48px;
                    border-width: 0px;
                    background: root.current-server != "" && (header-ta.has-hover || root.server-menu-open) ? Theme.hover : transparent;
                    header-ta := TouchArea {
                        enabled: root.current-server != "";
                        mouse-cursor: root.current-server != "" ? pointer : default;
                        clicked => { root.server-menu-open = !root.server-menu-open; }
                    }
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 12px;
                        Text {
                            text: root.current-server == "" ? "Mensagens diretas" : root.server-name;
                            color: Theme.txt;
                            font-weight: 700;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if root.current-server != "": VerticalLayout {
                            alignment: center;
                            Icon {
                                commands: root.server-menu-open ? "M 6 6 L 18 18 M 18 6 L 6 18" : Icons.chevron;
                                size: 18px;
                            }
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.rail;
                    }
                }

                // canais (sempre ocupa o espaço que sobra: a barra do perfil fica colada embaixo)
                Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        padding: 8px;
                        spacing: 2px;
                        if root.current-server == "": Rectangle {
                            height: 42px;
                            border-radius: 4px;
                            background: root.current-channel == "" ? Theme.active : friends-ta.has-hover ? Theme.hover : transparent;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 10px;
                                spacing: 12px;
                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        commands: Icons.users;
                                        tint: root.current-channel == "" ? Theme.txt : Theme.muted;
                                        size: 22px;
                                    }
                                }
                                Text {
                                    text: "Amigos";
                                    color: root.current-channel == "" ? Theme.txt : Theme.muted;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                if root.pending-count > 0: VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 20px;
                                        height: 20px;
                                        border-radius: 10px;
                                        background: Theme.danger;
                                        Text {
                                            text: root.pending-count;
                                            color: white;
                                            font-size: 12px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                            friends-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.go-home(); }
                            }
                        }
                        if root.current-server == "": SectionTitle { text: "MENSAGENS DIRETAS"; }
                        if root.current-server == "": VerticalLayout {
                            spacing: 2px;
                            for d in root.dms: DmRow {
                                dm: d;
                                selected: root.current-channel == d.id;
                                clicked => { root.open-dm(d.id); }
                            }
                        }
                        if root.current-server == "" && root.dms.length == 0: Text {
                            text: "Nenhuma conversa ainda. Abra uma pelo botão \"Mensagem\" de um amigo.";
                            color: Theme.faint;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        if root.current-server != "": ChannelSection {
                            text: "CANAIS DE TEXTO";
                            can-add: root.can-manage;
                            add => { root.open-channel-modal(false); }
                        }
                        for c in root.text-channels: ChannelRow {
                            name: c.name;
                            unread: c.unread;
                            selected: root.current-channel == c.id;
                            can-delete: root.can-manage;
                            clicked => { root.select-channel(c.id, false); }
                            delete => {
                                root.ask("delete-channel:" + c.id, "Apagar #" + c.name + "?",
                                    "O canal e todas as mensagens dele serão apagados para todo mundo. Não dá para desfazer.", "Apagar canal");
                            }
                        }
                        if root.current-server != "": ChannelSection {
                            text: "CANAIS DE VOZ";
                            can-add: root.can-manage;
                            add => { root.open-channel-modal(true); }
                        }
                        for c in root.voice-channels: VerticalLayout {
                            ChannelRow {
                                name: c.name;
                                voice: true;
                                selected: root.current-channel == c.id;
                                can-delete: root.can-manage;
                                clicked => { root.select-channel(c.id, true); }
                                delete => {
                                    root.ask("delete-channel:" + c.id, "Apagar o canal de voz " + c.name + "?",
                                        "Quem estiver nele sai da chamada. Não dá para desfazer.", "Apagar canal");
                                }
                            }
                            if root.voice-channel == c.id: VerticalLayout {
                                for m in root.voice-members: VoiceMemberRow {
                                    member: m;
                                    clicked => { root.show-profile(m.id); }
                                    menu(x, y) => { root.open-user-menu(m.id, m.name, x, y); }
                                }
                            }
                            if root.voice-channel != c.id: VerticalLayout {
                                for m in c.people: VoiceMemberRow {
                                    member: m;
                                    clicked => { root.show-profile(m.id); }
                                    menu(x, y) => { root.open-user-menu(m.id, m.name, x, y); }
                                }
                            }
                        }
                        if root.current-server != "" && root.invite-code != "": VerticalLayout {
                            padding-top: 16px;
                            spacing: 4px;
                            SectionTitle { text: "CÓDIGO DE CONVITE"; }
                            Rectangle {
                                height: 32px;
                                background: Theme.rail;
                                border-radius: 4px;
                                TextInput {
                                    x: 8px;
                                    width: parent.width - 16px;
                                    text: root.invite-code;
                                    read-only: true;
                                    color: Theme.txt;
                                    font-family: "Consolas";
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: "Selecione e Ctrl+C para copiar";
                                color: Theme.faint;
                                font-size: 11px;
                            }
                        }
                        // "mola": deixa a lista esticar mesmo quando todos os itens têm altura fixa
                        Rectangle { }
                    }
                }

                // faixa "AO VIVO" enquanto eu transmito
                if root.screen-live: Rectangle {
                    height: 44px;
                    background: Theme.panel;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 8px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            LiveBadge { }
                        }
                        Text {
                            text: root.screen-info;
                            color: Theme.muted;
                            font-size: 11px;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                        VerticalLayout {
                            alignment: center;
                            RecordButton {
                                recording: root.recording;
                                time: root.record-time;
                                clicked => { root.toggle-record(); }
                            }
                        }
                    }
                }

                // aviso "Gravação salva" (fica até fechar)
                if root.record-message != "": Rectangle {
                    height: rec-row.preferred-height;
                    background: Theme.panel;
                    rec-row := HorizontalLayout {
                        padding: 8px;
                        padding-left: 12px;
                        spacing: 8px;
                        Text {
                            text: root.record-message;
                            color: root.last-recording != "" ? Theme.ok : #f87171;
                            font-size: 11px;
                            wrap: word-wrap;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        VerticalLayout {
                            alignment: center;
                            SmallButton {
                                text: root.last-recording != "" ? "Mostrar" : "Pasta";
                                clicked => { root.show-recording(root.last-recording); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: "M 6 6 L 18 18 M 18 6 L 6 18";
                                tint: Theme.muted;
                                clicked => { root.record-message = ""; }
                            }
                        }
                    }
                }

                // painel "Voz conectada" (aparece durante a chamada)
                if root.voice-channel != "" || root.voice-connecting: Rectangle {
                    height: 96px;
                    background: Theme.panel;
                    VerticalLayout {
                        padding: 8px;
                        padding-left: 10px;
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 8px;
                            // sinal (a cor diz se a conexão está boa); passar o mouse mostra o ping
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 6px;
                                    background: signal-ta.has-hover ? Theme.hover : transparent;
                                    Icon {
                                        commands: Icons.signal;
                                        size: 20px;
                                        tint: root.voice-connecting ? #f0b232
                                            : root.voice-ping-level == 0 ? Theme.ok : root.voice-ping-level == 1 ? #f0b232 : Theme.danger;
                                    }
                                    signal-ta := TouchArea { }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: root.voice-connecting ? "Conectando..." : "Voz conectada";
                                    color: root.voice-connecting ? #f0b232 : Theme.ok;
                                    font-size: 14px;
                                    font-weight: 700;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.voice-channel-name + (root.voice-server-name == "" ? "" : " / " + root.voice-server-name);
                                    color: Theme.muted;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: Icons.hangup;
                                    tint: Theme.txt;
                                    clicked => { root.leave-voice(); }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            PanelButton {
                                icon: Icons.video;
                                on: root.camera-on;
                                busy: root.camera-busy;
                                clicked => {
                                    if root.voice-channel != "" && !root.camera-busy {
                                        root.toggle-camera();
                                    }
                                }
                            }
                            PanelButton {
                                icon: Icons.monitor;
                                on: root.screen-live;
                                clicked => {
                                    if root.screen-live {
                                        root.stop-screen();
                                    } else if root.voice-channel != "" {
                                        root.open-golive();
                                    }
                                }
                            }
                        }
                    }
                    // "28 ms" em cima do sinal, ao passar o mouse (igual ao Discord)
                    if signal-ta.has-hover: Rectangle {
                        x: 6px;
                        y: -28px;
                        width: ping-label.preferred-width + 16px;
                        height: 24px;
                        border-radius: 4px;
                        background: #111214;
                        drop-shadow-blur: 8px;
                        drop-shadow-color: #00000080;
                        ping-label := Text {
                            text: root.voice-ping != "" ? root.voice-ping : "Medindo...";
                            color: white;
                            font-size: 12px;
                            font-weight: 700;
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.hover;
                    }
                }

                // barra do usuário
                Rectangle {
                    height: 56px;
                    background: Theme.panel;
                    HorizontalLayout {
                        padding: 8px;
                        spacing: 4px;
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 4px;
                            background: me-ta.has-hover ? Theme.hover : transparent;
                            me-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.show-profile(""); }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                        Avatar {
                            url: root.me-avatar;
                            initials: root.me-initials;
                            tint: root.me-color;
                            size: 34px;
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: root.me-name;
                                color: Theme.txt;
                                font-size: 13px;
                                font-weight: 700;
                                overflow: elide;
                            }
                            Text {
                                text: "@" + root.me-username + "  ·  " + root.ram;
                                color: Theme.muted;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }
                            }
                        }
                        HorizontalLayout {
                            spacing: 0px;
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: Icons.mic;
                                    crossed: root.voice-muted;
                                    tint: root.voice-muted ? #f23f42 : Theme.muted;
                                    clicked => { root.toggle-mute(); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                ChevronButton { clicked => { root.open-voice-settings("voice"); } }
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: Icons.headphones;
                                    crossed: root.voice-deafened;
                                    tint: root.voice-deafened ? #f23f42 : Theme.muted;
                                    clicked => { root.toggle-deafen(); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                ChevronButton { clicked => { root.open-voice-settings("keys"); } }
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: Icons.gear;
                                    clicked => { root.open-voice-settings(root.settings-tab); }
                                }
                            }
                        }
                    }
                }
            }
            // borda arrastável: muda a largura da coluna (200 a 420 px) e salva ao soltar
            resize-ta := TouchArea {
                x: parent.width - 3px;
                width: 6px;
                mouse-cursor: ew-resize;
                moved => {
                    if self.pressed {
                        root.side-width = clamp(root.side-width + (self.mouse-x - self.pressed-x), 200px, 420px);
                    }
                }
                pointer-event(e) => {
                    if e.kind == PointerEventKind.up {
                        root.save-side-width(root.side-width / 1px);
                    }
                }
            }
            if resize-ta.has-hover || resize-ta.pressed: Rectangle {
                x: parent.width - 2px;
                width: 2px;
                background: Theme.brand;
            }
        }

        // área principal (chat)
        Rectangle {
            background: Theme.main;
            VerticalLayout {
                // cabeçalho do canal
                Rectangle {
                    height: root.theater ? 0px : 48px;
                    visible: !root.theater;
                    HorizontalLayout {
                        padding-left: 16px;
                        spacing: 8px;
                        Text {
                            text: root.channel-name == "" ? "" : root.channel-is-voice ? root.channel-name
                                : root.chat-is-dm ? "@  " + root.channel-name : "#  " + root.channel-name;
                            color: Theme.txt;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        if root.chat-is-dm && root.current-channel != "": HorizontalLayout {
                            horizontal-stretch: 1;
                            alignment: end;
                            padding-right: 12px;
                            spacing: 8px;
                            if root.voice-channel != root.current-channel: VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: Icons.phone;
                                    tint: Theme.txt;
                                    clicked => { root.call-dm(root.current-channel); }
                                }
                            }
                            if root.voice-channel == root.current-channel: VerticalLayout {
                                alignment: center;
                                SmallButton {
                                    text: root.show-call ? "Só o chat" : "Ver chamada";
                                    clicked => { root.show-call = !root.show-call; }
                                }
                            }
                        }
                        if root.current-server != "" && !root.channel-is-voice: HorizontalLayout {
                            horizontal-stretch: 1;
                            alignment: end;
                            padding-right: 12px;
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: Icons.users;
                                    tint: root.members-open ? Theme.txt : Theme.muted;
                                    clicked => { root.members-open = !root.members-open; }
                                }
                            }
                        }
                        if root.current-server == "" && root.current-channel == "": HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Icon { commands: Icons.users; size: 22px; }
                            }
                            Text {
                                text: "Amigos";
                                color: Theme.txt;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Rectangle { width: 12px; }
                            VerticalLayout {
                                alignment: center;
                                TabChip { text: "Disponível"; selected: root.friends-tab == "online"; clicked => { root.friends-tab = "online"; } }
                            }
                            VerticalLayout {
                                alignment: center;
                                TabChip { text: "Todos"; selected: root.friends-tab == "all"; clicked => { root.friends-tab = "all"; } }
                            }
                            VerticalLayout {
                                alignment: center;
                                TabChip {
                                    text: root.pending-count > 0 ? "Pendente (" + root.pending-count + ")" : "Pendente";
                                    selected: root.friends-tab == "pending";
                                    clicked => { root.friends-tab = "pending"; }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                TabChip { text: "Bloqueado"; selected: root.friends-tab == "blocked"; clicked => { root.friends-tab = "blocked"; } }
                            }
                            VerticalLayout {
                                alignment: center;
                                TabChip { text: "Adicionar amigo"; accent: true; selected: root.friends-tab == "add"; clicked => { root.friends-tab = "add"; } }
                            }
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.rail;
                    }
                }

                // mensagens (ou a tela da chamada, em canais de voz)
                Rectangle {
                    vertical-stretch: 1;
                    chat-list := ListView {
                        width: 100%;
                        height: 100%;
                        scrolled => {
                            // Chegou perto do topo: busca as mensagens anteriores.
                            if self.content-y > -80px && root.chat-has-more && !root.chat-loading-older {
                                root.load-older();
                            }
                        }
                        for m in root.messages: Rectangle {
                            height: row-lay.preferred-height;
                            background: row-ta.has-hover ? #2e3035 : transparent;
                            row-ta := TouchArea {
                                row-lay := HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    padding-top: m.grouped ? 2px : root.pref-compact ? 6px : 14px;
                                    padding-bottom: 2px;
                                    spacing: root.pref-compact ? 0px : 16px;
                                    Rectangle {
                                        width: root.pref-compact ? 0px : 40px;
                                        if !m.grouped && !root.pref-compact: Avatar {
                                            y: 0;
                                            url: m.avatar;
                                            initials: m.initials;
                                            tint: m.color;
                                            TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.show-profile(m.author-id); }
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 4px;
                                        if !m.grouped: HorizontalLayout {
                                            spacing: 8px;
                                            if root.pref-compact: Text {
                                                text: m.time;
                                                color: Theme.faint;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: m.author;
                                                color: m.color;
                                                font-weight: 600;
                                                TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.show-profile(m.author-id); }
                                                }
                                            }
                                            if !root.pref-compact: Text {
                                                text: m.time;
                                                color: Theme.faint;
                                                font-size: 12px;
                                                vertical-alignment: bottom;
                                            }
                                            Rectangle { }
                                        }
                                        if m.reply-id != "": HorizontalLayout {
                                            spacing: 6px;
                                            Text {
                                                text: "↱";
                                                color: Theme.faint;
                                                font-size: 13px;
                                            }
                                            if m.reply-author != "": Text {
                                                text: m.reply-author;
                                                color: m.reply-color;
                                                font-size: 12px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: m.reply-text;
                                                color: Theme.muted;
                                                font-size: 12px;
                                                overflow: elide;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                            }
                                        }
                                        if m.content != "" && m.jumbo.length == 0: StyledText {
                                            text: m.rich;
                                            default-color: root.editing-id == m.id ? Theme.brand : #dbdee1;
                                            link-color: #00a8fc;
                                            link-clicked(url) => { root.open-link(url); }
                                        }
                                        if m.jumbo.length > 0: HorizontalLayout {
                                            alignment: start;
                                            spacing: 2px;
                                            for e in m.jumbo: Image {
                                                width: 44px;
                                                height: 44px;
                                                source: Emoji.image(e);
                                            }
                                        }

                                        for a in m.attachments: HorizontalLayout {
                                            alignment: start;
                                            AttachmentView {
                                                att: a;
                                                open => { root.view-image(a.url, a.name); }
                                                save => { root.save-attachment(a.url, a.name); }
                                                play => { root.play-video(a.url, a.name); }
                                            }
                                        }
                                        if m.reactions.length > 0: HorizontalLayout {
                                            alignment: start;
                                            spacing: 4px;
                                            for r in m.reactions: Rectangle {
                                                height: 26px;
                                                width: chip-row.preferred-width;
                                                border-radius: 8px;
                                                background: r.mine ? Theme.brand.transparentize(75%) : chip-ta.has-hover ? Theme.hover : Theme.side;
                                                border-width: 1px;
                                                border-color: r.mine ? Theme.brand : chip-ta.has-hover ? Theme.active : transparent;
                                                animate background { duration: Motion.reduce ? 0ms : 100ms; }
                                                chip-row := HorizontalLayout {
                                                    padding-left: 6px;
                                                    padding-right: 8px;
                                                    spacing: 5px;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Image {
                                                            width: 17px;
                                                            height: 17px;
                                                            source: Emoji.image(r.emoji);
                                                        }
                                                    }
                                                    Text {
                                                        text: r.count;
                                                        color: r.mine ? #c9cdfb : Theme.muted;
                                                        font-size: 13px;
                                                        font-weight: 600;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                chip-ta := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.react(m.id, r.emoji); }
                                                }
                                            }
                                            Rectangle {
                                                height: 26px;
                                                width: 30px;
                                                border-radius: 8px;
                                                background: add-ta.has-hover ? Theme.hover : Theme.side;
                                                Icon {
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    commands: Icons.smile;
                                                    size: 16px;
                                                }
                                                add-ta := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.picker-for = m.id;
                                                        root.picker-open = true;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                // ações ao passar o mouse (editar / apagar)
                                if row-ta.has-hover: Rectangle {
                                    x: parent.width - self.width - 16px;
                                    y: 1px;
                                    width: actions.preferred-width;
                                    height: min(30px, parent.height - 2px);
                                    border-radius: 6px;
                                    background: Theme.main;
                                    border-width: 1px;
                                    border-color: Theme.rail;
                                    actions := HorizontalLayout {
                                        if root.pref-dev: IconButton {
                                            height: parent.height;
                                            icon: Icons.hash;
                                            clicked => { root.copy-id(m.id); }
                                        }
                                        IconButton {
                                            height: parent.height;
                                            icon: Icons.smile;
                                            clicked => {
                                                root.picker-for = m.id;
                                                root.picker-open = true;
                                            }
                                        }
                                        IconButton {
                                            height: parent.height;
                                            icon: Icons.reply;
                                            clicked => {
                                                root.editing-id = "";
                                                root.replying-id = m.id;
                                                root.replying-name = m.author;
                                            }
                                        }
                                        if m.mine && m.content != "": IconButton {
                                            height: parent.height;
                                            icon: Icons.pencil;
                                            clicked => {
                                                root.editing-id = m.id;
                                                root.composer-text = m.content;
                                            }
                                        }
                                        if m.can-delete: IconButton {
                                            height: parent.height;
                                            icon: Icons.trash;
                                            tint: Theme.danger;
                                            clicked => {
                                                root.ask("delete-message:" + m.id, "Apagar mensagem",
                                                    "Tem certeza que quer apagar esta mensagem? Não dá para desfazer.", "Apagar");
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if root.chat-loading-older: Rectangle {
                        y: 8px;
                        x: (parent.width - self.width) / 2;
                        width: 220px;
                        height: 28px;
                        border-radius: 14px;
                        background: Theme.side;
                        Text {
                            text: "Carregando mensagens antigas...";
                            color: Theme.muted;
                            font-size: 12px;
                        }
                    }
                    // página de amigos (início, sem conversa aberta)
                    if root.current-server == "" && root.current-channel == "": FriendsPage {
                        friends: root.friends;
                        tab: root.friends-tab;
                        result: root.friend-result;
                        ok: root.friend-ok;
                        online-count: root.online-count;
                        friend-count: root.friend-count;
                        pending-total: root.pending-total;
                        blocked-count: root.blocked-count;
                        add(name) => { root.add-friend(name); }
                        accept(id) => { root.accept-friend(id); }
                        remove(id) => { root.remove-friend(id); }
                        block(id) => { root.block-user(id); }
                        message(id) => { root.message-user(id); }
                        profile(id) => { root.show-profile(id); }
                    }

                    // tela da chamada (cobre as mensagens quando o canal é de voz)
                    if root.channel-is-voice || (root.chat-is-dm && root.show-call && root.voice-channel != "" && root.voice-channel == root.current-channel): call-area := TouchArea {
                        // Igual ao Discord: com o mouse fora da chamada (ou parado 3 s), os botões e
                        // os nomes somem; voltou o mouse, aparecem de novo.
                        property <bool> show-ui: self.has-hover && !root.call-idle;
                        Rectangle { background: #111214; }
                        TouchArea { }

                        // grade com uma pessoa por bloco (16:9), centralizada
                        if root.voice-channel == root.current-channel && root.voice-focus == "": Rectangle {
                            height: parent.height - 72px; // barra de controles embaixo
                            y: 0;
                            init => {
                                root.cam-tile-w = self.tile-w;
                                root.cam-tile-h = self.tile-h;
                            }
                            changed tile-w => {
                                root.cam-tile-w = self.tile-w;
                                root.cam-tile-h = self.tile-h;
                            }
                            property <int> n: max(1, root.voice-members.length);
                            property <int> cols: n <= 1 ? 1 : n <= 4 ? 2 : n <= 9 ? 3 : 4;
                            property <int> rows: ceil(n / cols);
                            property <length> gap: 8px;
                            property <length> pad: 16px;
                            property <length> fit-w: (self.width - 2 * pad - gap * (cols - 1)) / cols;
                            property <length> fit-h: (self.height - 2 * pad - gap * (rows - 1)) / rows;
                            property <length> tile-h: min(fit-w * 9 / 16, fit-h);
                            property <length> tile-w: tile-h * 16 / 9;
                            property <length> left: (self.width - cols * tile-w - (cols - 1) * gap) / 2;
                            property <length> top: (self.height - rows * tile-h - (rows - 1) * gap) / 2;
                            for m[i] in root.voice-members: VoiceTile {
                                member: m;
                                show-name: call-area.show-ui;
                                watch => { root.watch(m.id); }
                                menu(x, y) => { root.open-user-menu(m.id, m.name, x, y); }
                                clicked => { root.focus-member(m.id); }
                                width: tile-w;
                                height: tile-h;
                                x: left + Math.mod(i, cols) * (tile-w + gap);
                                y: top + floor(i / cols) * (tile-h + gap);
                            }
                        }

                        // uma pessoa em destaque (igual ao Discord): grande em cima, o resto embaixo
                        if root.voice-channel == root.current-channel && root.voice-focus != "": Rectangle {
                            height: parent.height - 72px;
                            y: 0;
                            property <length> pad: 16px;
                            property <length> gap: 8px;
                            property <length> strip-h: root.voice-others.length > 0 ? 110px : 0px;
                            property <length> area-w: self.width - 2 * pad;
                            property <length> area-h: self.height - 2 * pad - (root.voice-others.length > 0 ? strip-h + gap : 0px);
                            property <length> big-h: min(area-w * 9 / 16, area-h);
                            property <length> big-w: big-h * 16 / 9;
                            property <length> small-h: strip-h;
                            property <length> small-w: small-h * 16 / 9;
                            property <int> n: root.voice-others.length;
                            init => {
                                root.cam-big-w = self.big-w;
                                root.cam-big-h = self.big-h;
                                root.cam-tile-w = self.small-w;
                                root.cam-tile-h = self.small-h;
                            }
                            changed big-w => {
                                root.cam-big-w = self.big-w;
                                root.cam-big-h = self.big-h;
                            }
                            VoiceTile {
                                member: root.voice-focus-member;
                                big: true;
                                show-name: call-area.show-ui;
                                width: big-w;
                                height: big-h;
                                x: (parent.width - big-w) / 2;
                                y: pad + (area-h - big-h) / 2;
                                watch => { root.watch(root.voice-focus-member.id); }
                                menu(x, y) => { root.open-user-menu(root.voice-focus-member.id, root.voice-focus-member.name, x, y); }
                                clicked => { root.focus-member(root.voice-focus-member.id); }
                            }
                            for m[i] in root.voice-others: VoiceTile {
                                member: m;
                                show-name: call-area.show-ui;
                                watch => { root.watch(m.id); }
                                menu(x, y) => { root.open-user-menu(m.id, m.name, x, y); }
                                clicked => { root.focus-member(m.id); }
                                width: small-w;
                                height: small-h;
                                x: (parent.width - n * small-w - (n - 1) * gap) / 2 + i * (small-w + gap);
                                y: parent.height - pad - small-h;
                            }
                        }

                        // tela cheia da chamada (canto de baixo, igual ao Discord)
                        if root.voice-channel == root.current-channel && root.watching == "": Rectangle {
                            x: parent.width - 54px;
                            y: parent.height - 54px;
                            width: 36px;
                            height: 36px;
                            opacity: call-area.show-ui ? 1 : 0;
                            animate opacity { duration: Motion.reduce ? 0ms : 300ms; easing: ease-in-out; }
                            full-btn := IconButton {
                                width: 36px;
                                height: 36px;
                                icon: root.theater ? Icons.minimize : Icons.maximize;
                                tint: white;
                                hover-bg: #ffffff30;
                                clicked => { root.toggle-theater(); }
                            }
                            // dica em cima do botão
                            if full-btn.has-hover: Rectangle {
                                x: parent.width - self.width;
                                y: -34px;
                                width: full-tip.preferred-width + 16px;
                                height: 28px;
                                border-radius: 4px;
                                background: #111214;
                                full-tip := Text {
                                    text: root.theater ? "Sair da tela cheia" : "Tela cheia";
                                    color: white;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        // nome do canal em cima (a barra de cima some em tela cheia)
                        if root.theater && root.voice-channel == root.current-channel && root.watching == "": Text {
                            x: 16px;
                            y: 4px;
                            height: 24px;
                            text: "🔊  " + root.channel-name;
                            color: white;
                            font-weight: 700;
                            vertical-alignment: center;
                            opacity: call-area.show-ui ? 1 : 0;
                            animate opacity { duration: Motion.reduce ? 0ms : 300ms; easing: ease-in-out; }
                        }
                        // Esc sai da tela cheia
                        if root.theater && root.watching == "": FocusScope {
                            width: 0px;
                            height: 0px;
                            init => { self.focus(); }
                            key-pressed(event) => {
                                if event.text == Key.Escape {
                                    root.toggle-theater();
                                    return accept;
                                }
                                reject
                            }
                        }

                        // assistindo uma live: ocupa a área toda
                        if root.voice-channel == root.current-channel && root.watching != "": Rectangle {
                            height: parent.height - 72px;
                            y: 0;
                            background: #000000;
                            TouchArea {
                                double-clicked => { root.toggle-theater(); }
                            }
                            Image {
                                x: 16px;
                                y: 16px + 44px;
                                width: parent.width - 32px;
                                height: parent.height - 32px - 44px;
                                source: root.stream-frame;
                                // O quadro já chega do tamanho certo: desenhar sem escalar poupa CPU.
                                image-fit: preserve;
                            }
                            Rectangle {
                                x: 16px;
                                y: 16px;
                                height: 36px;
                                width: watch-row.preferred-width;
                                border-radius: 6px;
                                background: #000000b0;
                                watch-row := HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 4px;
                                    spacing: 10px;
                                    VerticalLayout {
                                        alignment: center;
                                        LiveBadge { }
                                    }
                                    Text {
                                        text: root.watching-name;
                                        color: white;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: root.watch-info;
                                        color: Theme.muted;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        IconButton {
                                            icon: Icons.maximize;
                                            tint: white;
                                            hover-bg: #ffffff30;
                                            clicked => { root.toggle-theater(); }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        PrimaryButton {
                                            width: 140px;
                                            height: 28px;
                                            text: "Parar de assistir";
                                            tint: Theme.active;
                                            clicked => { root.stop-watching(); }
                                        }
                                    }
                                }
                            }
                        }

                        // fora da chamada deste canal: botão para entrar
                        if root.voice-channel != root.current-channel: VerticalLayout {
                            alignment: center;
                            spacing: 12px;
                            Text {
                                text: root.channel-name;
                                color: Theme.txt;
                                font-size: 26px;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: root.voice-connecting ? "Entrando na chamada..." : root.voice-error != "" ? root.voice-error : "Ninguém te ouve ainda. Entre quando quiser.";
                                color: root.voice-error != "" && !root.voice-connecting ? #f87171 : Theme.muted;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                            if !root.voice-connecting: HorizontalLayout {
                                alignment: center;
                                PrimaryButton {
                                    width: 180px;
                                    text: "Entrar na chamada";
                                    tint: Theme.ok;
                                    clicked => { root.join-voice(root.current-channel); }
                                }
                            }
                        }

                        // barra de controles da chamada (igual à do Discord)
                        if root.voice-channel != "" && root.voice-channel == root.current-channel: HorizontalLayout {
                            y: parent.height - 72px;
                            height: 72px;
                            opacity: call-area.show-ui ? 1 : 0;
                            animate opacity { duration: Motion.reduce ? 0ms : 300ms; easing: ease-in-out; }
                            padding-top: 12px;
                            padding-bottom: 12px;
                            spacing: 8px;
                            alignment: center;
                            CallButton {
                                icon: Icons.mic;
                                crossed: root.voice-muted;
                                menu: true;
                                clicked => { root.toggle-mute(); }
                                menu-clicked => {
                                    root.settings-tab = "voice";
                                    root.clear-password-fields();
                                    root.open-settings();
                                }
                            }
                            CallButton {
                                icon: Icons.headphones;
                                crossed: root.voice-deafened;
                                menu: true;
                                clicked => { root.toggle-deafen(); }
                                menu-clicked => {
                                    root.settings-tab = "keys";
                                    root.clear-password-fields();
                                    root.open-settings();
                                }
                            }
                            Rectangle { width: 8px; }
                            CallButton {
                                icon: Icons.video;
                                on: root.camera-on;
                                clicked => {
                                    if !root.camera-busy {
                                        root.toggle-camera();
                                    }
                                }
                            }
                            CallButton {
                                icon: Icons.monitor;
                                on: root.screen-live;
                                clicked => {
                                    if root.screen-live {
                                        root.stop-screen();
                                    } else {
                                        root.open-golive();
                                    }
                                }
                            }
                            Rectangle { width: 8px; }
                            CallButton {
                                icon: Icons.hangup;
                                danger: true;
                                clicked => { root.leave-voice(); }
                            }
                        }
                    }
                }
                if root.chat-error != "": Text {
                    text: root.chat-error;
                    color: #f87171;
                    horizontal-alignment: center;
                    height: 24px;
                }

                // campo de mensagem
                if root.current-channel != "" && !root.channel-is-voice: VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 6px;
                    // Quando começa a editar, o cursor vai para o campo.
                    property <string> eid: root.editing-id;
                    changed eid => {
                        if self.eid != "" {
                            input.focus();
                        }
                    }
                    property <string> rid: root.replying-id;
                    changed rid => {
                        if self.rid != "" {
                            input.focus();
                        }
                    }
                    if root.replying-id != "" && root.editing-id == "": HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Respondendo a " + root.replying-name;
                            color: Theme.muted;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        SmallButton {
                            height: 24px;
                            text: "Cancelar";
                            clicked => {
                                root.replying-id = "";
                            }
                        }
                    }
                    if root.editing-id != "": HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Editando mensagem (Enter salva)";
                            color: Theme.brand;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        SmallButton {
                            height: 24px;
                            text: "Cancelar";
                            clicked => {
                                root.editing-id = "";
                                root.composer-text = "";
                            }
                        }
                    }
                    if root.pending-files.length > 0: HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for f[i] in root.pending-files: Rectangle {
                            height: 28px;
                            width: min(200px, chip.preferred-width);
                            border-radius: 4px;
                            background: Theme.side;
                            chip := HorizontalLayout {
                                padding-left: 8px;
                                spacing: 2px;
                                Text {
                                    text: f;
                                    color: Theme.txt;
                                    font-size: 12px;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                IconButton {
                                    width: 24px;
                                    height: 28px;
                                    icon: "M 7 7 L 17 17 M 17 7 L 7 17";
                                    clicked => { root.remove-pending(i); }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: Icons.paperclip;
                                clicked => { root.pick-files(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: Icons.smile;
                                clicked => {
                                    root.picker-for = "";
                                    root.picker-open = true;
                                }
                            }
                        }
                        input := LineEdit {
                            text <=> root.composer-text;
                            enabled: !root.chat-sending;
                            placeholder-text: root.chat-is-dm ? "Conversar com @" + root.channel-name : "Conversar em #" + root.channel-name;
                            edited(text) => {
                                if text != "" && root.editing-id == "" {
                                    root.typing();
                                }
                            }
                            accepted(text) => {
                                if root.editing-id != "" {
                                    root.edit-message(root.editing-id, text);
                                    root.editing-id = "";
                                    root.composer-text = "";
                                } else if text != "" || root.pending-files.length > 0 {
                                    root.send-message(text, root.replying-id);
                                    root.composer-text = "";
                                    root.replying-id = "";
                                }
                            }
                        }
                    }
                    Text {
                        height: 20px;
                        text: root.chat-sending ? "Enviando arquivos..." : root.typing-text;
                        color: Theme.muted;
                        font-size: 12px;
                        font-italic: root.typing-text != "" && !root.chat-sending;
                        vertical-alignment: top;
                    }
                }
            }
        }

        // membros do servidor (online primeiro)
        if root.current-server != "" && root.members-open && !root.channel-is-voice: Rectangle {
            width: 240px;
            background: Theme.side;
            VerticalLayout {
                Rectangle {
                    height: 48px;
                    Text {
                        x: 16px;
                        height: parent.height;
                        text: "Membros";
                        color: Theme.txt;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
                Flickable {
                    VerticalLayout {
                        padding: 8px;
                        spacing: 2px;
                        alignment: start;
                        for m in root.members: VerticalLayout {
                            if m.header: HorizontalLayout {
                                padding-left: 8px;
                                SectionTitle { text: m.name; }
                            }
                            if !m.header: MemberRow {
                                m: m;
                                clicked => { root.show-profile(m.id); }
                            }
                        }
                    }
                }
            }
        }
    }

    // ---------------- configurações (tela cheia com barra lateral, igual ao Discord)
    if root.settings-open: Rectangle {
        background: Theme.main;
        TouchArea { }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.settings-open = false;
                    return accept;
                }
                reject
            }
        }
        HorizontalLayout {
            // ---- categorias
            settings-side := Rectangle {
                width: max(250px, (root.width - 780px) / 2);
                background: Theme.side;
                Flickable {
                    VerticalLayout {
                        alignment: start;
                        padding-top: 40px;
                        padding-bottom: 24px;
                        padding-right: 10px;
                        padding-left: max(12px, settings-side.width - 238px);
                        spacing: 2px;
                        // quem sou eu + "Editar perfil"
                        HorizontalLayout {
                            height: 56px;
                            spacing: 10px;
                            padding-left: 6px;
                            VerticalLayout {
                                alignment: center;
                                Avatar {
                                    size: 42px;
                                    url: root.me-avatar;
                                    initials: root.me-initials;
                                    tint: root.me-color;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: root.me-name;
                                    color: Theme.txt;
                                    font-weight: 700;
                                    overflow: elide;
                                }
                                Text {
                                    text: "Editar perfil  ✎";
                                    color: edit-ta.has-hover ? Theme.txt : Theme.muted;
                                    font-size: 13px;
                                    edit-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.settings-open = false;
                                            root.open-profile();
                                        }
                                    }
                                }
                            }
                        }
                        LineEdit {
                            placeholder-text: "Buscar";
                            text <=> root.settings-search;
                        }
                        Rectangle { height: 6px; }
                        for e in root.settings-nav: Rectangle {
                            property <bool> shown: root.settings-search == "" || (!e.head && Prefs.matches(e.label, root.settings-search));
                            height: !self.shown ? 0px : e.head ? 34px : 34px;
                            visible: self.shown;
                            border-radius: 4px;
                            background: e.head ? transparent : root.settings-tab == e.id ? Theme.active : nav-ta.has-hover ? Theme.hover : transparent;
                            Text {
                                x: 10px;
                                width: parent.width - 20px;
                                text: e.label;
                                color: e.head ? Theme.faint : root.settings-tab == e.id || nav-ta.has-hover ? Theme.txt : Theme.muted;
                                font-size: e.head ? 12px : 15px;
                                font-weight: e.head ? 700 : 500;
                                vertical-alignment: e.head ? bottom : center;
                                height: e.head ? parent.height - 6px : parent.height;
                                y: 0;
                                overflow: elide;
                            }
                            nav-ta := TouchArea {
                                enabled: !e.head;
                                mouse-cursor: e.head ? default : pointer;
                                clicked => {
                                    root.settings-tab = e.id;
                                    if e.id == "games" {
                                        root.refresh-games();
                                    }
                                }
                            }
                        }
                        Rectangle { height: 8px; }
                        Rectangle { height: 1px; background: Theme.hover; }
                        Rectangle {
                            height: 34px;
                            border-radius: 4px;
                            background: out-ta.has-hover ? Theme.hover : transparent;
                            Text {
                                x: 10px;
                                text: "Sair";
                                color: #f87171;
                                font-size: 15px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                            out-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.settings-open = false;
                                    root.logout();
                                }
                            }
                        }
                        Rectangle { height: 1px; background: Theme.hover; }
                        Rectangle { height: 8px; }
                        Text {
                            x: 10px;
                            text: "Polley " + root.app-version + " (Windows)";
                            color: Theme.faint;
                            font-size: 12px;
                        }
                        HorizontalLayout {
                            padding-left: 10px;
                            spacing: 10px;
                            Text {
                                text: "Política de privacidade";
                                color: #38bdf8;
                                font-size: 12px;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.open-legal("privacidade"); }
                                }
                            }
                            Text {
                                text: "Termos de uso";
                                color: #38bdf8;
                                font-size: 12px;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.open-legal("termos"); }
                                }
                            }
                            Rectangle { }
                        }
                    }
                }
            }
            // ---- conteúdo da categoria
            Rectangle {
                horizontal-stretch: 1;
                Flickable {
                    HorizontalLayout {
                        alignment: start;
                        padding-left: 40px;
                        padding-right: 90px;
                        VerticalLayout {
                            alignment: start;
                            width: min(700px, root.width - settings-side.width - 130px);
                            padding-top: 48px;
                            padding-bottom: 80px;
                            spacing: 8px;
                            Text {
                                text: root.settings-title;
                                color: Theme.txt;
                                font-size: 22px;
                                font-weight: 700;
                            }
                            Rectangle { height: 8px; }

// ============ MINHA CONTA
                if root.settings-tab == "account": VerticalLayout {
                    spacing: 10px;
                    Rectangle {
                        height: 120px;
                        border-radius: 8px;
                        background: Theme.panel;
                        clip: true;
                        Rectangle {
                            y: 0;
                            height: 56px;
                            background: root.me-color;
                        }
                        Rectangle {
                            x: 16px;
                            y: 20px;
                            width: 84px;
                            height: 84px;
                            border-radius: 42px;
                            background: Theme.panel;
                            Avatar {
                                x: 4px;
                                y: 4px;
                                size: 76px;
                                url: root.me-avatar;
                                initials: root.me-initials;
                                tint: root.me-color;
                            }
                        }
                        Text {
                            x: 112px;
                            y: 68px;
                            text: root.me-name;
                            color: Theme.txt;
                            font-size: 20px;
                            font-weight: 700;
                        }
                        SmallButton {
                            x: parent.width - self.width - 16px;
                            y: 72px;
                            text: "Editar perfil de usuário";
                            tint: Theme.brand;
                            clicked => {
                                root.settings-open = false;
                                root.open-profile();
                            }
                        }
                    }
                    Rectangle {
                        border-radius: 8px;
                        background: Theme.panel;
                        height: info-col.preferred-height;
                        info-col := VerticalLayout {
                            padding: 16px;
                            spacing: 14px;
                            VerticalLayout {
                                Text { text: "NOME DE EXIBIÇÃO"; color: Theme.muted; font-size: 12px; font-weight: 700; }
                                Text { text: root.acc-display; color: Theme.txt; }
                            }
                            VerticalLayout {
                                Text { text: "NOME DE USUÁRIO"; color: Theme.muted; font-size: 12px; font-weight: 700; }
                                Text { text: root.acc-username; color: Theme.txt; }
                            }
                            HorizontalLayout {
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    Text { text: "EMAIL"; color: Theme.muted; font-size: 12px; font-weight: 700; }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: root.acc-show-email ? root.acc-email : root.acc-email-masked;
                                            color: Theme.txt;
                                        }
                                        Text {
                                            text: root.acc-show-email ? "Esconder" : "Mostrar";
                                            color: #38bdf8;
                                            TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.acc-show-email = !root.acc-show-email; }
                                            }
                                        }
                                        Rectangle { }
                                    }
                                }
                            }
                        }
                    }
                    SectionTitle { text: "STATUS DA CONTA"; }
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 36px;
                                height: 36px;
                                border-radius: 18px;
                                background: Theme.ok.transparentize(75%);
                                Text {
                                    text: "✓";
                                    color: Theme.ok;
                                    font-size: 18px;
                                    font-weight: 800;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text { text: "Tudo certo!"; color: Theme.txt; font-weight: 700; }
                            Text {
                                text: "Obrigado por seguir os Termos de Uso do Polley. Se algum dia houver um problema com a sua conta, ele aparece aqui.";
                                color: Theme.muted;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                        }
                    }
                    Rectangle { height: 8px; }
                    SectionTitle { text: "REMOÇÃO DA CONTA"; }
                    if !root.acc-delete-step && !root.acc-deactivate-step: VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: "Desativar é temporário: ninguém consegue te mandar pedido de amizade e você sai da conta. Para voltar, é só entrar de novo. Excluir apaga tudo para sempre.";
                            color: Theme.muted;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            SmallButton {
                                text: "Desativar conta";
                                clicked => {
                                    root.account-error = "";
                                    root.acc-deactivate-step = true;
                                }
                            }
                            SmallButton {
                                text: "Excluir conta";
                                tint: Theme.danger;
                                clicked => {
                                    root.account-error = "";
                                    root.account-info = "";
                                    root.acc-delete-step = true;
                                }
                            }
                        }
                    }
                    if root.acc-deactivate-step: VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: "Desativar sua conta? Você vai sair do Polley neste computador. Quando entrar de novo, ela volta ao normal.";
                            color: Theme.txt;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 8px;
                            SmallButton {
                                text: "Cancelar";
                                clicked => { root.acc-deactivate-step = false; }
                            }
                            SmallButton {
                                text: "Desativar";
                                tint: Theme.danger;
                                clicked => {
                                    root.acc-deactivate-step = false;
                                    root.settings-open = false;
                                    root.deactivate-account();
                                }
                            }
                        }
                    }
                    if root.acc-delete-step: VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: "Isso NÃO pode ser desfeito. Serão apagados: seu perfil, fotos, amizades, DMs, todas as suas mensagens e os servidores que você criou (com tudo dentro deles). Digite sua senha para confirmar.";
                            color: #f87171;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        LineEdit {
                            placeholder-text: "Sua senha";
                            input-type: InputType.password;
                            text <=> root.acc-delete-password;
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 8px;
                            SmallButton {
                                text: "Cancelar";
                                clicked => {
                                    root.acc-delete-step = false;
                                    root.acc-delete-password = "";
                                }
                            }
                            SmallButton {
                                text: root.account-busy ? "..." : "Excluir para sempre";
                                tint: Theme.danger;
                                clicked => {
                                    if !root.account-busy {
                                        root.account-error = "";
                                        root.delete-account(root.acc-delete-password);
                                    }
                                }
                            }
                        }
                    }
                    if root.account-error != "": Text {
                        text: root.account-error;
                        color: #f87171;
                        wrap: word-wrap;
                    }
                }

// ============ SENHA E SEGURANÇA
                if root.settings-tab == "security": VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        SectionTitle {
                            text: "SENHA";
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        CheckBox {
                            text: "Mostrar senhas";
                            checked <=> root.show-passwords;
                        }
                    }
                    LineEdit {
                        placeholder-text: "Senha atual";
                        input-type: root.show-passwords ? InputType.text : InputType.password;
                        text <=> root.acc-current;
                    }
                    LineEdit {
                        placeholder-text: "Senha nova (mínimo 8 caracteres)";
                        input-type: root.show-passwords ? InputType.text : InputType.password;
                        text <=> root.acc-new;
                    }
                    LineEdit {
                        placeholder-text: "Repita a senha nova";
                        input-type: root.show-passwords ? InputType.text : InputType.password;
                        text <=> root.acc-confirm;
                        accepted => { root.change-password(root.acc-current, root.acc-new, root.acc-confirm); }
                    }
                    HorizontalLayout {
                        alignment: start;
                        SmallButton {
                            text: root.account-busy ? "..." : "Trocar senha";
                            tint: Theme.brand;
                            clicked => {
                                if !root.account-busy {
                                    root.account-error = "";
                                    root.account-info = "";
                                    root.change-password(root.acc-current, root.acc-new, root.acc-confirm);
                                }
                            }
                        }
                    }
                    if root.account-error != "": Text {
                        text: root.account-error;
                        color: #f87171;
                        wrap: word-wrap;
                    }
                    if root.account-info != "": Text {
                        text: root.account-info;
                        color: #4ade80;
                        wrap: word-wrap;
                    }
                    Rectangle { height: 8px; }
                    SectionTitle { text: "VERIFICAÇÃO EM 2 ETAPAS"; }
                    if root.mfa-enabled: HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "✓ Ativada";
                            color: Theme.ok;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Rectangle { }
                    }
                    Text {
                        text: root.mfa-enabled
                            ? "Para entrar na sua conta, além da senha, é preciso o código de 6 dígitos do app autenticador. Para desativar, digite um código do app."
                            : "Protege sua conta mesmo se alguém descobrir sua senha: para entrar, também vai ser preciso o código de 6 dígitos de um app autenticador no celular (Google Authenticator, Microsoft Authenticator, Authy...).";
                        color: Theme.muted;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    if !root.mfa-enabled && !root.mfa-setup: HorizontalLayout {
                        alignment: start;
                        SmallButton {
                            text: root.mfa-busy ? "..." : "Ativar verificação em 2 etapas";
                            tint: Theme.brand;
                            clicked => {
                                if !root.mfa-busy {
                                    root.mfa-code = "";
                                    root.mfa-start();
                                }
                            }
                        }
                    }
                    if root.mfa-setup: HorizontalLayout {
                        spacing: 20px;
                        Rectangle {
                            width: 180px;
                            height: 180px;
                            border-radius: 8px;
                            background: white;
                            clip: true;
                            Image {
                                width: parent.width;
                                height: parent.height;
                                source: root.mfa-qr;
                                image-fit: contain;
                                image-rendering: pixelated;
                            }
                        }
                        VerticalLayout {
                            spacing: 8px;
                            horizontal-stretch: 1;
                            Text {
                                text: "1. Abra o app autenticador no celular e escaneie o QR code.\n2. Digite abaixo o código de 6 dígitos que aparecer.";
                                color: Theme.txt;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "Não dá para escanear? Digite a chave no app:";
                                color: Theme.muted;
                                font-size: 12px;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: root.mfa-secret;
                                    color: Theme.txt;
                                    font-size: 12px;
                                    font-family: "Consolas";
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }
                                SmallButton {
                                    text: "Copiar";
                                    clicked => { root.copy-id(root.mfa-secret); }
                                }
                            }
                            LineEdit {
                                placeholder-text: "Código de 6 dígitos";
                                text <=> root.mfa-code;
                                accepted => { root.mfa-confirm(root.mfa-code); }
                            }
                            HorizontalLayout {
                                alignment: start;
                                spacing: 8px;
                                SmallButton {
                                    text: "Cancelar";
                                    clicked => { root.mfa-setup = false; }
                                }
                                SmallButton {
                                    text: root.mfa-busy ? "..." : "Confirmar";
                                    tint: Theme.brand;
                                    clicked => {
                                        if !root.mfa-busy {
                                            root.mfa-confirm(root.mfa-code);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if root.mfa-enabled: HorizontalLayout {
                        spacing: 8px;
                        LineEdit {
                            placeholder-text: "Código do app";
                            text <=> root.mfa-code;
                            horizontal-stretch: 1;
                        }
                        SmallButton {
                            text: root.mfa-busy ? "..." : "Desativar";
                            tint: Theme.danger;
                            clicked => {
                                if !root.mfa-busy {
                                    root.mfa-disable(root.mfa-code);
                                    root.mfa-code = "";
                                }
                            }
                        }
                    }
                    if root.mfa-error != "": Text {
                        text: root.mfa-error;
                        color: #f87171;
                        wrap: word-wrap;
                    }
                    if root.mfa-info != "": Text {
                        text: root.mfa-info;
                        color: #4ade80;
                        wrap: word-wrap;
                    }
                    Rectangle { height: 8px; }
                    SectionTitle { text: "APARELHOS CONECTADOS"; }
                    Text {
                        text: "Esqueceu a conta aberta em outro computador ou acha que alguém entrou nela? Saia de todos os aparelhos de uma vez (inclusive deste). Depois é só entrar de novo.";
                        color: Theme.muted;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: start;
                        SmallButton {
                            text: "Sair de todos os aparelhos";
                            tint: Theme.danger;
                            clicked => {
                                root.settings-open = false;
                                root.logout-all();
                            }
                        }
                    }
                }

// ============ DADOS E PRIVACIDADE
                if root.settings-tab == "privacy": VerticalLayout {
                    spacing: 8px;
                    SectionTitle { text: "QUEM PODE TE MANDAR PEDIDO DE AMIZADE"; }
                    CheckBox {
                        text: "Todo mundo";
                        checked: root.priv-everyone;
                        toggled => { root.set-privacy("everyone", self.checked); }
                    }
                    CheckBox {
                        text: "Amigos dos meus amigos";
                        enabled: !root.priv-everyone;
                        checked: root.priv-everyone || root.priv-fof;
                        toggled => { root.set-privacy("fof", self.checked); }
                    }
                    CheckBox {
                        text: "Membros dos servidores em que eu estou";
                        enabled: !root.priv-everyone;
                        checked: root.priv-everyone || root.priv-servers;
                        toggled => { root.set-privacy("servers", self.checked); }
                    }
                    Text {
                        text: "Quem não se encaixar recebe \"Essa pessoa não está aceitando pedidos de amizade de você\". A regra vale no servidor do Polley, não só no app.";
                        color: Theme.faint;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    SectionTitle { text: "MENSAGENS DIRETAS"; }
                    Text {
                        text: "No Polley, só amigos podem te mandar mensagem direta e te ligar. Quem você bloqueia não consegue te mandar mensagem, ligar nem ver você online.";
                        color: Theme.muted;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    SectionTitle { text: "COMO USAMOS SEUS DADOS"; }
                    Text {
                        text: "Anexos de DM só abrem para quem está na conversa. Sua senha nunca fica salva no computador, e a sessão fica criptografada pelo Windows.";
                        color: Theme.muted;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: start;
                        SmallButton {
                            text: "Ler a Política de Privacidade";
                            clicked => { root.open-legal("privacidade"); }
                        }
                    }
                }

// ============ NOTIFICAÇÕES
                if root.settings-tab == "notifications": VerticalLayout {
                    spacing: 8px;
                    SectionTitle { text: "MENSAGENS DIRETAS E MENÇÕES (@VOCÊ)"; }
                    CheckBox {
                        text: "Tocar um som";
                        checked: root.pref-notif-sound;
                        toggled => { root.set-pref("notif-sound", self.checked ? "true" : "false"); }
                    }
                    CheckBox {
                        text: "Mostrar aviso do Windows (quem mandou e o começo da mensagem)";
                        checked: root.pref-notif-popup;
                        toggled => { root.set-pref("notif-popup", self.checked ? "true" : "false"); }
                    }
                    CheckBox {
                        text: "Piscar o ícone do Polley na barra de tarefas";
                        checked: root.pref-notif-flash;
                        toggled => { root.set-pref("notif-flash", self.checked ? "true" : "false"); }
                    }
                    Text {
                        text: "Os avisos só aparecem quando o Polley não está na frente, e respeitam o \"Não perturbe\" e os jogos em tela cheia do Windows.";
                        color: Theme.faint;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    SectionTitle { text: "NÃO LIDAS"; }
                    CheckBox {
                        text: "Bolinha vermelha no ícone da barra de tarefas quando houver mensagens não lidas";
                        checked: root.pref-notif-badge;
                        toggled => { root.set-pref("notif-badge", self.checked ? "true" : "false"); }
                    }
                    SectionTitle { text: "SONS DA CHAMADA"; }
                    CheckBox {
                        text: "Sons ao mutar, ensurdecer, entrar e sair da chamada";
                        checked: root.keys-sounds;
                        toggled => { root.set-call-sounds(self.checked); }
                    }
                }

// ============ APARÊNCIA
                if root.settings-tab == "appearance": VerticalLayout {
                    spacing: 8px;
                    SectionTitle { text: "TEMA"; }
                    HorizontalLayout {
                        spacing: 16px;
                        alignment: start;
                        for t in [
                            { id: "dark", label: "Escuro", a: #313338, b: #2b2d31, c: #1e1f22 },
                            { id: "midnight", label: "Meia-noite", a: #1a1a1e, b: #141417, c: #0b0b0d },
                        ]: VerticalLayout {
                            spacing: 6px;
                            Rectangle {
                                width: 150px;
                                height: 90px;
                                border-radius: 8px;
                                border-width: root.pref-theme == t.id ? 3px : 1px;
                                border-color: root.pref-theme == t.id ? Theme.brand : Theme.hover;
                                background: t.a;
                                clip: true;
                                Rectangle { x: 0; width: 22px; background: t.c; }
                                Rectangle { x: 22px; width: 40px; background: t.b; }
                                Rectangle { x: 74px; y: 20px; width: 60px; height: 8px; border-radius: 4px; background: #ffffff30; }
                                Rectangle { x: 74px; y: 36px; width: 44px; height: 8px; border-radius: 4px; background: #ffffff20; }
                                Rectangle { x: 74px; y: 52px; width: 52px; height: 8px; border-radius: 4px; background: #ffffff20; }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.set-pref("theme", t.id); }
                                }
                            }
                            Text {
                                text: t.label;
                                color: root.pref-theme == t.id ? Theme.txt : Theme.muted;
                                font-weight: 600;
                                horizontal-alignment: center;
                            }
                        }
                    }
                    SectionTitle { text: "EXIBIÇÃO DAS MENSAGENS"; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        TabChip {
                            text: "Aconchegante (com foto)";
                            selected: !root.pref-compact;
                            clicked => { root.set-pref("compact", "false"); }
                        }
                        TabChip {
                            text: "Compacto (cabe mais na tela)";
                            selected: root.pref-compact;
                            clicked => { root.set-pref("compact", "true"); }
                        }
                    }
                    Text {
                        text: "O tamanho do texto fica em Acessibilidade.";
                        color: Theme.faint;
                        font-size: 12px;
                    }
                }

// ============ ACESSIBILIDADE
                if root.settings-tab == "accessibility": VerticalLayout {
                    spacing: 8px;
                    SectionTitle { text: "TAMANHO DO TEXTO"; }
                    HorizontalLayout {
                        spacing: 12px;
                        Slider {
                            minimum: 12;
                            maximum: 22;
                            value: root.pref-chat-font;
                            horizontal-stretch: 1;
                            changed(v) => { root.set-pref("chat-font", round(v)); }
                        }
                        Text {
                            width: 50px;
                            text: root.pref-chat-font + " px";
                            color: Theme.txt;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        border-radius: 8px;
                        background: Theme.panel;
                        height: font-demo.preferred-height + 24px;
                        font-demo := Text {
                            x: 12px;
                            width: parent.width - 24px;
                            text: "Assim fica o texto das mensagens e dos nomes. 👋";
                            color: #dbdee1;
                            font-size: root.pref-chat-font * 1px;
                            wrap: word-wrap;
                        }
                    }
                    SectionTitle { text: "MOVIMENTO"; }
                    CheckBox {
                        text: "Reduzir animações";
                        checked: root.pref-reduce-motion;
                        toggled => { root.set-pref("reduce-motion", self.checked ? "true" : "false"); }
                    }
                    Text {
                        text: "Tira as transições de cor, tamanho e o esmaecer dos botões (bom para quem sente enjoo ou prefere tudo instantâneo).";
                        color: Theme.faint;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }

// ============ IDIOMA E HORÁRIO
                if root.settings-tab == "language": VerticalLayout {
                    spacing: 8px;
                    SectionTitle { text: "IDIOMA"; }
                    Rectangle {
                        height: 44px;
                        border-radius: 6px;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: Theme.brand;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            Text {
                                text: "Português do Brasil";
                                color: Theme.txt;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: "✓";
                                color: Theme.brand;
                                font-weight: 800;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Text {
                        text: "Mais idiomas em breve.";
                        color: Theme.faint;
                        font-size: 12px;
                    }
                    SectionTitle { text: "FORMATO DA HORA"; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        TabChip {
                            text: "24 horas (15:05)";
                            selected: root.pref-clock24;
                            clicked => { root.set-pref("clock24", "true"); }
                        }
                        TabChip {
                            text: "12 horas (3:05 PM)";
                            selected: !root.pref-clock24;
                            clicked => { root.set-pref("clock24", "false"); }
                        }
                    }
                }

// ============ JOGOS REGISTRADOS
                if root.settings-tab == "games": VerticalLayout {
                    spacing: 8px;
                    Rectangle {
                        height: 72px;
                        border-radius: 8px;
                        background: root.game-now != "" ? Theme.ok.transparentize(80%) : Theme.panel;
                        border-width: 1px;
                        border-color: root.game-now != "" ? Theme.ok : Theme.hover;
                        HorizontalLayout {
                            padding: 16px;
                            spacing: 12px;
                            Text {
                                text: "🎮";
                                font-size: 26px;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: root.game-now != "" ? root.game-now : "Nenhum jogo detectado";
                                    color: Theme.txt;
                                    font-weight: 700;
                                }
                                Text {
                                    text: root.game-now != "" ? (root.pref-share-activity ? "Jogando agora — seus amigos veem isso." : "Jogando agora — escondido (Privacidade nas atividades).")
                                        : "Abra um jogo: o Polley reconhece sozinho os mais populares.";
                                    color: Theme.muted;
                                    font-size: 13px;
                                }
                            }
                        }
                    }
                    SectionTitle { text: "JOGOS ADICIONADOS POR VOCÊ"; }
                    if root.games-added.length == 0: Text {
                        text: "Nenhum ainda. Se um jogo seu não for reconhecido, adicione abaixo.";
                        color: Theme.faint;
                        font-size: 13px;
                    }
                    for g in root.games-added: HorizontalLayout {
                        height: 40px;
                        spacing: 10px;
                        Text {
                            text: g.name;
                            color: Theme.txt;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Text {
                            text: g.exe;
                            color: Theme.faint;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        VerticalLayout {
                            alignment: center;
                            SmallButton {
                                text: "Remover";
                                clicked => { root.remove-game(g.exe); }
                            }
                        }
                    }
                    SectionTitle { text: "ADICIONAR UM JOGO"; }
                    Text {
                        text: "Deixe o jogo aberto, escolha ele na lista e dê o nome que vai aparecer para os seus amigos.";
                        color: Theme.muted;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        ComboBox {
                            model: root.games-running;
                            current-index <=> root.game-pick;
                            horizontal-stretch: 1;
                        }
                        SmallButton {
                            text: "Atualizar lista";
                            clicked => { root.refresh-games(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        LineEdit {
                            placeholder-text: "Nome do jogo (opcional)";
                            text <=> root.game-name;
                            horizontal-stretch: 1;
                        }
                        SmallButton {
                            text: "Adicionar";
                            tint: Theme.brand;
                            clicked => {
                                root.add-game(root.game-pick, root.game-name);
                                root.game-name = "";
                            }
                        }
                    }
                    Text {
                        text: "O Polley olha só os nomes dos programas abertos (como o Gerenciador de Tarefas), a cada 15 segundos. Nada dentro do jogo é lido — não dá problema com anticheat.";
                        color: Theme.faint;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }

// ============ PRIVACIDADE NAS ATIVIDADES
                if root.settings-tab == "activity": VerticalLayout {
                    spacing: 8px;
                    SectionTitle { text: "COMPARTILHAR MINHA ATIVIDADE"; }
                    CheckBox {
                        text: "Mostrar o jogo que estou jogando";
                        checked: root.pref-share-activity;
                        toggled => { root.set-pref("share-activity", self.checked ? "true" : "false"); }
                    }
                    Text {
                        text: "Aparece embaixo do seu nome para amigos e membros dos seus servidores, como no Discord: \"Jogando VALORANT\". Desligado, ninguém vê o que você está jogando.";
                        color: Theme.faint;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }

// ============ DESENVOLVEDOR
                if root.settings-tab == "developer": VerticalLayout {
                    spacing: 8px;
                    CheckBox {
                        text: "Modo desenvolvedor";
                        checked: root.pref-dev;
                        toggled => { root.set-pref("dev", self.checked ? "true" : "false"); }
                    }
                    Text {
                        text: "Mostra \"Copiar ID\" no menu das pessoas (botão direito), nas mensagens (ao passar o mouse) e no menu do servidor. Útil para reportar problemas ou criar bots.";
                        color: Theme.faint;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }

// ============ SISTEMA / ATALHOS / VOZ (vieram da janela antiga)
                if root.settings-tab == "windows": VerticalLayout {
                    spacing: 8px;
                    SectionTitle { text: "INICIALIZAÇÃO"; }
                    CheckBox {
                        text: "Abrir o Polley quando o Windows iniciar";
                        enabled: root.win-can-autostart;
                        checked: root.win-autostart;
                        toggled => { root.set-windows-option("autostart", self.checked); }
                    }
                    CheckBox {
                        text: "Começar minimizado (só o ícone perto do relógio)";
                        enabled: root.win-can-autostart && root.win-autostart;
                        checked: root.win-minimized;
                        toggled => { root.set-windows-option("minimized", self.checked); }
                    }
                    if !root.win-can-autostart: Text {
                        text: "Disponível só no Polley instalado.";
                        color: Theme.faint;
                        font-size: 12px;
                    }
                    SectionTitle { text: "BANDEJA DO SISTEMA"; }
                    CheckBox {
                        text: "Ao fechar (X), deixar o Polley rodando perto do relógio";
                        checked: root.win-tray;
                        toggled => { root.set-windows-option("tray", self.checked); }
                    }
                    Text {
                        text: "Assim você continua recebendo mensagens e ligações. Para sair de vez, clique com o botão direito no ícone do Polley perto do relógio → Sair do Polley.";
                        color: Theme.faint;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
                if root.settings-tab == "keys": VerticalLayout {
                    spacing: 8px;
                    SectionTitle { text: "MODO DE ENTRADA"; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        TabChip {
                            text: "Detecção de voz";
                            selected: !root.keys-ptt;
                            clicked => { root.set-push-to-talk(false); }
                        }
                        TabChip {
                            text: "Apertar para falar";
                            selected: root.keys-ptt;
                            clicked => { root.set-push-to-talk(true); }
                        }
                    }
                    if root.keys-ptt: HorizontalLayout {
                        spacing: 8px;
                        height: 36px;
                        Text {
                            text: "Tecla para falar:";
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 4px;
                            background: Theme.rail;
                            border-width: root.keys-capturing == "ptt" ? 1px : 0px;
                            border-color: Theme.brand;
                            Text {
                                text: root.keys-capturing == "ptt" ? "Aperte uma tecla ou botão do mouse... (Esc cancela)"
                                    : root.keys-ptt-name != "" ? root.keys-ptt-name : "Nenhuma — escolha uma";
                                color: root.keys-ptt-name == "" && root.keys-capturing != "ptt" ? #f87171 : Theme.txt;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            SmallButton {
                                text: "Mudar";
                                clicked => { root.capture-key("ptt"); }
                            }
                        }
                    }
                    Text {
                        text: root.keys-ptt ? "O microfone só abre enquanto você segura a tecla, mesmo com o jogo aberto e o Polley minimizado."
                            : "O microfone abre sozinho quando você fala.";
                        color: Theme.faint;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    SectionTitle { text: "ATALHOS (FUNCIONAM DENTRO DO JOGO)"; }
                    for row in [
                        { id: "mute", label: "Mutar / desmutar:", name: root.keys-mute-name },
                        { id: "deafen", label: "Ensurdecer:", name: root.keys-deafen-name },
                    ]: HorizontalLayout {
                        spacing: 8px;
                        height: 36px;
                        Text {
                            width: 120px;
                            text: row.label;
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 4px;
                            background: Theme.rail;
                            border-width: root.keys-capturing == row.id ? 1px : 0px;
                            border-color: Theme.brand;
                            Text {
                                text: root.keys-capturing == row.id ? "Aperte o atalho... (Esc cancela)"
                                    : row.name != "" ? row.name : "Nenhum";
                                color: row.name == "" && root.keys-capturing != row.id ? Theme.faint : Theme.txt;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            SmallButton {
                                text: "Mudar";
                                clicked => { root.capture-key(row.id); }
                            }
                        }
                        if row.name != "": VerticalLayout {
                            alignment: center;
                            SmallButton {
                                text: "Limpar";
                                clicked => { root.clear-key(row.id); }
                            }
                        }
                    }
                    Text {
                        text: "Dica: use Ctrl, Shift ou Alt junto (ex.: Ctrl + Shift + M) para não apertar sem querer no meio do jogo.";
                        color: Theme.faint;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
                if root.settings-tab == "voice" && root.settings-loading: Text {
                    text: "Procurando aparelhos...";
                    color: Theme.muted;
                }
                if root.settings-tab == "voice" && !root.settings-loading: VerticalLayout {
                    spacing: 8px;
                    SectionTitle { text: "MICROFONE"; }
                    ComboBox {
                        model: root.settings-mics;
                        current-index <=> root.settings-mic;
                    }
                    SectionTitle { text: "SAÍDA DE SOM (FONE / CAIXA)"; }
                    ComboBox {
                        model: root.settings-speakers;
                        current-index <=> root.settings-speaker;
                    }
                    SectionTitle { text: "CÂMERA"; }
                    ComboBox {
                        model: root.settings-cameras;
                        current-index <=> root.settings-camera;
                    }
                    CheckBox {
                        text: "Mostrar minha própria câmera na chamada";
                        checked: root.show-own-camera;
                        toggled => { root.user-menu("show-own-camera", ""); }
                    }
                    CheckBox {
                        text: "Câmera em alta qualidade (mais nítida, gasta mais internet)";
                        checked: root.camera-hq;
                        toggled => { root.user-menu("camera-hq", ""); }
                    }
                    Rectangle { height: 4px; }
                    CheckBox {
                        text: "Supressão de ruído (tira barulho de fundo, teclado, ventilador)";
                        checked <=> root.settings-noise;
                    }
                    SectionTitle { text: "TESTE DE MICROFONE"; }
                    HorizontalLayout {
                        spacing: 10px;
                        SmallButton {
                            text: root.mic-testing ? "Parar teste" : "Testar microfone";
                            tint: root.mic-testing ? Theme.active : Theme.brand;
                            clicked => {
                                if root.mic-testing {
                                    root.stop-mic-test();
                                } else {
                                    root.start-mic-test(root.settings-mic, root.settings-speaker);
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Rectangle {
                                height: 8px;
                                border-radius: 4px;
                                background: Theme.rail;
                                clip: true;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * root.mic-level;
                                    border-radius: 4px;
                                    background: root.mic-level > 0.95 ? Theme.danger : Theme.ok;
                                    animate width { duration: Motion.reduce ? 0ms : 60ms; }
                                }
                            }
                        }
                    }
                    if root.mic-testing: CheckBox {
                        text: "Ouvir meu microfone (só com fone de ouvido)";
                        checked: root.mic-monitor;
                        toggled => { root.set-mic-monitor(self.checked); }
                    }
                    if root.mic-feedback: Text {
                        text: "⚠ Microfonia! O som da caixa voltou para o microfone. Desligamos o retorno: use fone de ouvido para se ouvir.";
                        color: Theme.danger;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    if !root.mic-feedback: Text {
                        text: "Fale algo: a barra verde mostra se o microfone está te ouvindo. Com caixa de som, não ligue o retorno — dá microfonia (um chiado alto).";
                        color: Theme.faint;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "Microfone e saída mudam na hora, até no meio da chamada. A câmera nova vale na próxima vez que você ligar a câmera.";
                        color: Theme.faint;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        SmallButton {
                            text: "Salvar";
                            tint: Theme.brand;
                            clicked => {
                                root.save-settings(root.settings-mic, root.settings-speaker, root.settings-camera, root.settings-noise);
                            }
                        }
                    }
                }

                        }
                    }
                }
                // fechar (X + ESC), como no Discord
                VerticalLayout {
                    x: parent.width - 70px;
                    y: 48px;
                    width: 44px;
                    spacing: 4px;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        x: 4px;
                        border-radius: 18px;
                        border-width: 2px;
                        border-color: close-ta.has-hover ? Theme.txt : Theme.faint;
                        background: close-ta.has-hover ? Theme.hover : transparent;
                        Icon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            commands: "M 6 6 L 18 18 M 18 6 L 6 18";
                            tint: close-ta.has-hover ? Theme.txt : Theme.muted;
                            size: 18px;
                        }
                        close-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.settings-open = false; }
                        }
                    }
                    Text {
                        text: "ESC";
                        color: Theme.faint;
                        font-size: 12px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }

    // ---------------- verificação em 2 etapas no login
    if root.ready && !root.logged-in && root.auth-mfa-mode: Rectangle {
        background: Theme.rail;
        TouchArea { }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 440px;
                    height: mfa-col.preferred-height;
                    background: Theme.main;
                    border-radius: 8px;
                    mfa-col := VerticalLayout {
                        padding: 32px;
                        spacing: 14px;
                        Text {
                            text: "Verificação em 2 etapas";
                            font-size: 24px;
                            font-weight: 700;
                            color: Theme.txt;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Abra o app autenticador no seu celular e digite o código de 6 dígitos do Polley.";
                            color: Theme.muted;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        Field {
                            label: "CÓDIGO DO APP";
                            text <=> root.auth-code;
                            accepted => { root.verify-login-mfa(root.auth-code); }
                        }
                        if root.auth-error != "": Text {
                            text: root.auth-error;
                            color: #f87171;
                            wrap: word-wrap;
                        }
                        PrimaryButton {
                            text: root.auth-busy ? "..." : "Entrar";
                            enabled: !root.auth-busy;
                            clicked => { root.verify-login-mfa(root.auth-code); }
                        }
                        Text {
                            text: "Voltar para o login";
                            color: #38bdf8;
                            font-size: 13px;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.logout(); }
                            }
                        }
                    }
                }
            }
        }
    }

    // ---------------- ligação chegando (DM)
    if root.incoming-dm != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: 24px;
        width: 360px;
        height: 84px;
        border-radius: 10px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.ok;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000090;
        HorizontalLayout {
            padding: 16px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                Avatar {
                    url: root.incoming-avatar;
                    initials: root.incoming-initials;
                    tint: root.incoming-color;
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: root.incoming-name;
                    color: Theme.txt;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: "está te ligando...";
                    color: Theme.muted;
                    font-size: 12px;
                }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: decline-ta.has-hover ? Theme.danger.brighter(15%) : Theme.danger;
                    Icon { commands: Icons.hangup; tint: white; }
                    decline-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.decline-call(); }
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: answer-ta.has-hover ? Theme.ok.brighter(15%) : Theme.ok;
                    Icon { commands: Icons.phone; tint: white; }
                    answer-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.answer-call(root.incoming-dm); }
                    }
                }
            }
        }
    }

    // ---------------- ver imagem anexada (clicar fora ou no X fecha)
    if root.viewer-open: Rectangle {
        background: #000000e0;
        TouchArea {
            clicked => { root.close-viewer(); }
        }
        if root.viewer-status == "": Image {
            x: 32px;
            y: 64px;
            width: parent.width - 64px;
            height: parent.height - 96px;
            source: root.viewer-image;
            image-fit: contain;
        }
        if root.viewer-status != "": Text {
            text: root.viewer-status;
            color: white;
            font-size: 16px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        HorizontalLayout {
            y: 12px;
            height: 40px;
            padding-left: 24px;
            padding-right: 16px;
            spacing: 8px;
            Text {
                text: root.viewer-name;
                color: white;
                font-weight: 600;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if root.viewer-url != "": VerticalLayout {
                alignment: center;
                SmallButton {
                    text: "Abrir no navegador";
                    clicked => { root.open-attachment(root.viewer-url); }
                }
            }
            if root.viewer-url != "": VerticalLayout {
                alignment: center;
                SmallButton {
                    text: "Baixar";
                    clicked => { root.save-attachment(root.viewer-url, root.viewer-name); }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: "M 6 6 L 18 18 M 18 6 L 6 18";
                    tint: white;
                    hover-bg: #ffffff30;
                    clicked => { root.close-viewer(); }
                }
            }
        }
    }

    // ---------------- live em tela cheia
    if root.theater && root.watching != "": Rectangle {
        background: #000000;
        Image {
            width: 100%;
            height: 100%;
            source: root.stream-frame;
            image-fit: preserve;
        }
        full-ta := TouchArea {
            mouse-cursor: full-ta.mouse-y < 70px ? MouseCursor.default : MouseCursor.none;
            double-clicked => { root.toggle-theater(); }
        }
        // A live desce um pouco enquanto a barra de cima aparece (senão a live a cobriria).
        property <bool> bar: full-ta.has-hover && full-ta.mouse-y < 70px;
        init => { root.theater-bar = self.bar; }
        changed bar => { root.theater-bar = self.bar; }
        // barra de cima: só aparece com o mouse no topo
        if full-ta.has-hover && full-ta.mouse-y < 70px: Rectangle {
            y: 0;
            height: 56px;
            background: #000000b0;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    LiveBadge { }
                }
                Text {
                    text: root.watching-name + "   " + root.watch-info;
                    color: white;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    PrimaryButton {
                        width: 200px;
                        height: 32px;
                        text: "Sair da tela cheia (Esc)";
                        tint: Theme.active;
                        clicked => { root.toggle-theater(); }
                    }
                }
            }
        }
        esc := FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.toggle-theater();
                    return accept;
                }
                reject
            }
        }
    }

    // ---------------- modal: transmitir a tela
    if root.golive-open: Rectangle {
        background: #000000b0;
        TouchArea {
            clicked => { root.close-golive(); }
        }
        Rectangle {
            width: min(680px, parent.width - 32px);
            height: golive-col.preferred-height;
            x: (parent.width - self.width) / 2;
            y: max(16px, (parent.height - self.height) / 2);
            background: Theme.main;
            border-radius: 8px;
            TouchArea { }
            golive-col := VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text {
                    text: "Transmitir sua tela";
                    color: Theme.txt;
                    font-size: 22px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Escolha o que mostrar para quem está em " + root.voice-channel-name + ".";
                    color: Theme.muted;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Choice {
                        text: "Telas (" + root.golive-screens.length + ")";
                        selected: !root.golive-tab-windows;
                        clicked => { root.golive-tab-windows = false; }
                    }
                    Choice {
                        text: "Janelas (" + root.golive-windows.length + ")";
                        selected: root.golive-tab-windows;
                        clicked => { root.golive-tab-windows = true; }
                    }
                }
                // grade de miniaturas: 3 por linha
                sources := Flickable {
                    height: 260px;
                    property <length> gap: 10px;
                    property <length> card-w: (self.width - 2 * self.gap) / 3;
                    property <length> card-h: 150px;
                    property <[SourceItem]> items: root.golive-tab-windows ? root.golive-windows : root.golive-screens;
                    content-height: ceil(self.items.length / 3) * (self.card-h + self.gap);
                    for item[i] in sources.items: SourceCard {
                        x: mod(i, 3) * (sources.card-w + sources.gap);
                        y: floor(i / 3) * (sources.card-h + sources.gap);
                        width: sources.card-w;
                        height: sources.card-h;
                        item: item;
                        selected: root.golive-source == item.id;
                        clicked => {
                            root.golive-source = item.id;
                            root.golive-source-window = root.golive-tab-windows;
                        }
                    }
                    if sources.items.length == 0: Text {
                        width: parent.width;
                        height: 120px;
                        text: root.golive-loading ? "Procurando..." : "Nenhuma janela aberta para transmitir.";
                        color: Theme.faint;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                SectionTitle { text: "QUALIDADE"; }
                HorizontalLayout {
                    spacing: 8px;
                    Choice { text: "720p"; selected: root.golive-height == 720; clicked => { root.golive-height = 720; } }
                    Choice { text: "1080p"; selected: root.golive-height == 1080; clicked => { root.golive-height = 1080; } }
                    Choice { text: "1440p (2K)"; selected: root.golive-height == 1440; clicked => { root.golive-height = 1440; } }
                    Choice { text: "4K"; selected: root.golive-height == 2160; clicked => { root.golive-height = 2160; } }
                    Rectangle { width: 16px; }
                    Choice { text: "30 fps"; selected: root.golive-fps == 30; clicked => { root.golive-fps = 30; } }
                    Choice { text: "60 fps"; selected: root.golive-fps == 60; clicked => { root.golive-fps = 60; } }
                }
                CheckBox {
                    text: root.golive-source-window ? "Transmitir o som dessa janela" : "Transmitir o som do PC (menos o do Polley)";
                    checked <=> root.golive-audio;
                }
                Text {
                    text: "Se a tela ou janela for menor que a qualidade escolhida, a live usa o tamanho dela.";
                    color: Theme.faint;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                if root.screen-error != "": Text {
                    text: root.screen-error;
                    color: #f87171;
                    wrap: word-wrap;
                }
                PrimaryButton {
                    text: root.screen-busy ? "Iniciando..." : "Ir ao vivo";
                    enabled: !root.screen-busy && root.golive-source != "";
                    tint: Theme.ok;
                    clicked => { root.start-screen(root.golive-source, root.golive-height, root.golive-fps, root.golive-audio); }
                }
            }
        }
    }

    // ---------------- card de perfil (clicar na foto/nome de alguém)
    if root.card-open: Rectangle {
        background: #00000080;
        TouchArea {
            clicked => { root.card-open = false; }
        }
        // clicar dentro do card não fecha
        TouchArea {
            x: card-view.x;
            y: card-view.y;
            width: card-view.width;
            height: card-view.height;
        }
        card-view := ProfileCard {
            width: 340px;
            x: (parent.width - self.width) / 2;
            y: max(16px, (parent.height - self.height) / 2);
            name: root.card.name;
            username: root.card.username;
            initials: root.card.initials;
            avatar: root.card.avatar;
            banner: root.card.banner;
            bio: root.card.bio;
            since: root.card.since;
            primary: root.card.primary;
            accent: root.card.accent;
            card-bg: root.card.background;
            card-text: root.card.text;
            online: root.card.online || root.card.relation == "me";
            show-status: root.card.relation == "me" || root.card.relation == "friend";
            activity: root.card.activity;
            deactivated: root.card.deactivated;
            Rectangle { height: 10px; }
            if root.card.relation == "me": PrimaryButton {
                text: "Editar perfil";
                tint: root.card.primary;
                clicked => { root.open-profile(); }
            }
            if root.card.relation == "friend": PrimaryButton {
                text: "Enviar mensagem";
                tint: root.card.primary;
                clicked => {
                    root.card-open = false;
                    root.message-user(root.card.id);
                }
            }
            if root.card.relation == "none": PrimaryButton {
                text: "Adicionar amigo";
                tint: root.card.primary;
                clicked => { root.card-add-friend(root.card.id, root.card.username); }
            }
            if root.card.relation == "outgoing" || root.card.relation == "incoming": Text {
                text: root.card.relation == "outgoing" ? "Pedido de amizade enviado." : "Te mandou um pedido de amizade (veja em Amigos → Pendente).";
                color: root.card.text.transparentize(20%);
                font-size: 13px;
                wrap: word-wrap;
            }
            if root.card-message != "": Text {
                text: root.card-message;
                color: root.card.text;
                font-size: 12px;
                wrap: word-wrap;
            }
            if root.card-can-moderate: HorizontalLayout {
                spacing: 6px;
                if root.my-role == "owner": SmallButton {
                    text: root.card-role == "admin" ? "Remover admin" : "Tornar admin";
                    clicked => {
                        root.card-open = false;
                        if root.card-role == "admin" {
                            root.ask("demote:" + root.card.id, "Remover admin de " + root.card.name + "?",
                                "A pessoa volta a ser membro comum: não cria nem apaga canais e não modera mais ninguém.", "Remover admin");
                        } else {
                            root.ask("promote:" + root.card.id, "Tornar " + root.card.name + " admin?",
                                "Admins criam e apagam canais, apagam mensagens de outros e podem expulsar ou banir membros comuns.", "Tornar admin");
                        }
                    }
                }
                SmallButton {
                    text: "Expulsar";
                    clicked => {
                        root.card-open = false;
                        root.ask("kick:" + root.card.id, "Expulsar " + root.card.name + "?",
                            "A pessoa sai do servidor agora, mas pode voltar se receber o código de convite de novo.", "Expulsar");
                    }
                }
                SmallButton {
                    text: "Banir";
                    tint: Theme.danger;
                    clicked => {
                        root.card-open = false;
                        root.ask("ban:" + root.card.id, "Banir " + root.card.name + "?",
                            "A pessoa sai do servidor e não consegue voltar nem com o código de convite. Dá para desbanir depois em Menu do servidor → Banidos.", "Banir");
                    }
                }
            }
        }
    }

    // ---------------- editor de perfil
    if root.profile-open: Rectangle {
        background: #000000b0;
        TouchArea { }
        Rectangle {
            width: min(parent.width - 32px, 860px);
            height: min(parent.height - 32px, 640px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.main;
            border-radius: 8px;
            clip: true;
            HorizontalLayout {
                // formulário (rola se a janela for baixa)
                Flickable {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: 24px;
                        spacing: 10px;
                        alignment: start;
                        Text {
                            text: "Meu perfil";
                            color: Theme.txt;
                            font-size: 22px;
                            font-weight: 700;
                        }
                        SectionTitle { text: "NOME DE EXIBIÇÃO"; }
                        LineEdit {
                            text <=> root.edit-name;
                            placeholder-text: root.edit-username;
                        }
                        SectionTitle { text: "SOBRE MIM  (" + root.edit-bio.character-count + "/190)"; }
                        TextEdit {
                            text <=> root.edit-bio;
                            height: 76px;
                            wrap: word-wrap;
                        }

                        SectionTitle { text: "FOTO E BANNER"; }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            GhostButton {
                                text: "Trocar foto";
                                enabled: root.profile-busy == "";
                                clicked => { root.pick-image("avatar", false); }
                            }
                            GhostButton {
                                text: "Trocar banner";
                                enabled: root.profile-busy == "";
                                clicked => { root.pick-image("banner", false); }
                            }
                            if root.edit-avatar != "" || root.edit-banner != "": GhostButton {
                                text: "Remover imagens";
                                enabled: root.profile-busy == "";
                                clicked => { root.remove-images(); }
                            }
                        }

                        Rectangle {
                            height: pal-col.preferred-height;
                            border-radius: 8px;
                            background: Theme.panel;
                            pal-col := VerticalLayout {
                                padding: 14px;
                                spacing: 8px;
                                Text {
                                    text: "Pegar cores de uma imagem";
                                    color: Theme.txt;
                                    font-weight: 700;
                                }
                                Text {
                                    text: "Escolha uma foto e o Polley monta o tema com as cores dela.";
                                    color: Theme.muted;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    GhostButton {
                                        text: "Escolher imagem";
                                        enabled: root.profile-busy == "";
                                        clicked => { root.pick-image("palette", root.palette-banner); }
                                    }
                                    CheckBox {
                                        text: "Usar também como banner";
                                        checked <=> root.palette-banner;
                                    }
                                }
                            }
                        }

                        SectionTitle { text: "TEMAS PRONTOS"; }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            for t[i] in root.presets: PresetSwatch {
                                t: t;
                                clicked => { root.apply-preset(i); }
                            }
                        }

                        SectionTitle { text: "CORES  (digite o código e aperte Enter)"; }
                        for s[i] in root.edit-slots: ColorRow {
                            slot: s;
                            changed(hex) => { root.set-color(i, hex); }
                        }
                    }
                }

                // pré-visualização + botões
                Rectangle {
                    width: 372px;
                    background: Theme.side;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        SectionTitle { text: "PRÉ-VISUALIZAÇÃO"; }
                        ProfileCard {
                            name: root.edit-name != "" ? root.edit-name : root.edit-username;
                            username: root.edit-username;
                            initials: root.me-initials;
                            avatar: root.edit-avatar;
                            banner: root.edit-banner;
                            bio: root.edit-bio;
                            since: root.edit-since;
                            primary: root.edit-slots.length > 0 ? root.edit-slots[0].color : Theme.brand;
                            accent: root.edit-slots.length > 1 ? root.edit-slots[1].color : Theme.brand;
                            card-bg: root.edit-slots.length > 2 ? root.edit-slots[2].color : Theme.panel;
                            card-text: root.edit-slots.length > 3 ? root.edit-slots[3].color : Theme.txt;
                            online: true;
                            show-status: true;
                        }
                        Rectangle { vertical-stretch: 1; }
                        if root.profile-busy != "": Text {
                            text: root.profile-busy;
                            color: Theme.muted;
                            wrap: word-wrap;
                        }
                        if root.profile-error != "": Text {
                            text: root.profile-error;
                            color: #f87171;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            PrimaryButton {
                                text: "Cancelar";
                                tint: Theme.active;
                                clicked => { root.profile-open = false; }
                            }
                            PrimaryButton {
                                text: "Salvar";
                                tint: Theme.ok;
                                enabled: root.profile-busy == "";
                                clicked => { root.save-profile(root.edit-name, root.edit-bio); }
                            }
                        }
                    }
                }
            }
        }
    }

    // ---------------- menu do servidor (clicar no nome dele)
    if root.server-menu-open && root.current-server != "": Rectangle {
        TouchArea {
            clicked => { root.server-menu-open = false; }
        }
        Rectangle {
            x: 72px + 8px;
            y: 52px;
            width: 224px;
            height: menu-col.preferred-height;
            background: Theme.rail;
            border-radius: 6px;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000080;
            TouchArea { }
            menu-col := VerticalLayout {
                padding: 6px;
                spacing: 2px;
                if root.pref-dev: MenuItem {
                    text: "Copiar ID do servidor";
                    clicked => {
                        root.server-menu-open = false;
                        root.copy-id(root.current-server);
                    }
                }
                if root.my-role == "owner": MenuItem {
                    text: "Configurações do servidor";
                    clicked => {
                        root.server-menu-open = false;
                        root.open-server-settings();
                    }
                }
                if root.can-manage: MenuItem {
                    text: "Gerar novo convite";
                    clicked => {
                        root.server-menu-open = false;
                        root.ask("new-invite", "Gerar um convite novo?",
                            "O código atual para de funcionar na hora. Quem já está no servidor continua nele.", "Gerar convite");
                    }
                }
                if root.can-manage: MenuItem {
                    text: "Criar canal";
                    clicked => { root.open-channel-modal(false); }
                }
                if root.can-manage: MenuItem {
                    text: "Banidos";
                    clicked => {
                        root.server-menu-open = false;
                        root.open-bans();
                    }
                }
                if root.my-role == "owner": MenuItem {
                    text: "Excluir servidor";
                    danger: true;
                    clicked => {
                        root.ask("delete-server", "Excluir \"" + root.server-name + "\"?",
                            "O servidor, os canais e todas as mensagens serão apagados para todo mundo. Não dá para desfazer.", "Excluir servidor");
                    }
                }
                if root.my-role != "owner": MenuItem {
                    text: "Sair do servidor";
                    danger: true;
                    clicked => {
                        root.ask("leave-server", "Sair de \"" + root.server-name + "\"?",
                            "Você só volta se alguém te passar o código de convite de novo.", "Sair do servidor");
                    }
                }
            }
        }
    }

    // ---------------- modal: configurações do servidor (dono)
    if root.srv-edit-open: Rectangle {
        background: #000000b0;
        TouchArea {
            clicked => { if !root.srv-edit-busy { root.srv-edit-open = false; } }
        }
        Rectangle {
            width: 460px;
            height: srv-col.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.main;
            border-radius: 8px;
            TouchArea { }
            srv-col := VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text {
                    text: "Configurações do servidor";
                    color: Theme.txt;
                    font-size: 20px;
                    font-weight: 700;
                }
                HorizontalLayout {
                    spacing: 16px;
                    VerticalLayout {
                        alignment: start;
                        Avatar {
                            size: 80px;
                            url: root.srv-edit-icon;
                            initials: root.srv-edit-initials;
                            tint: Theme.brand;
                        }
                    }
                    VerticalLayout {
                        spacing: 8px;
                        alignment: center;
                        Text {
                            text: "Tamanho recomendado: 512 x 512 ou maior.";
                            color: Theme.muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            SmallButton {
                                text: "Trocar ícone";
                                clicked => { root.pick-server-icon(); }
                            }
                            if root.srv-edit-icon != "": GhostButton {
                                text: "Remover";
                                clicked => { root.remove-server-icon(); }
                            }
                        }
                    }
                }
                SectionTitle { text: "NOME DO SERVIDOR"; }
                LineEdit {
                    text <=> root.srv-edit-name;
                    placeholder-text: "Nome do servidor";
                }
                SectionTitle { text: "CÓDIGO DE CONVITE"; }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        height: 32px;
                        background: Theme.rail;
                        border-radius: 4px;
                        horizontal-stretch: 1;
                        TextInput {
                            x: 8px;
                            width: parent.width - 16px;
                            text: root.invite-code;
                            read-only: true;
                            color: Theme.txt;
                            font-family: "Consolas";
                            vertical-alignment: center;
                        }
                    }
                    SmallButton {
                        text: "Gerar novo";
                        clicked => {
                            root.ask("new-invite", "Gerar um convite novo?",
                                "O código atual para de funcionar na hora. Quem já está no servidor continua nele.", "Gerar convite");
                        }
                    }
                }
                if root.srv-edit-error != "": Text {
                    text: root.srv-edit-error;
                    color: #f87171;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    GhostButton {
                        text: "Cancelar";
                        enabled: !root.srv-edit-busy;
                        clicked => { root.srv-edit-open = false; }
                    }
                    SmallButton {
                        text: root.srv-edit-busy ? "Aguarde..." : "Salvar";
                        tint: Theme.ok;
                        clicked => { if !root.srv-edit-busy { root.save-server(root.srv-edit-name); } }
                    }
                }
            }
        }
    }

    // ---------------- modal: criar canal
    if root.channel-modal-open: Rectangle {
        background: #000000b0;
        TouchArea {
            clicked => { root.channel-modal-open = false; }
        }
        Rectangle {
            width: 440px;
            height: chan-col.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.main;
            border-radius: 8px;
            TouchArea { }
            chan-col := VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text {
                    text: "Criar canal";
                    color: Theme.txt;
                    font-size: 22px;
                    font-weight: 700;
                }
                SectionTitle { text: "TIPO DE CANAL"; }
                HorizontalLayout {
                    spacing: 8px;
                    Choice { text: "#  Texto"; selected: !root.channel-modal-voice; clicked => { root.channel-modal-voice = false; } }
                    Choice { text: "Voz"; selected: root.channel-modal-voice; clicked => { root.channel-modal-voice = true; } }
                }
                Text {
                    text: root.channel-modal-voice ? "Voz, transmissão de tela e gravação." : "Mensagens do servidor.";
                    color: Theme.faint;
                    font-size: 12px;
                }
                SectionTitle { text: "NOME DO CANAL"; }
                chan-input := LineEdit {
                    placeholder-text: root.channel-modal-voice ? "Sala de jogos" : "novo-canal";
                    accepted(text) => { root.create-channel(text, root.channel-modal-voice); }
                }
                if root.channel-error != "": Text {
                    text: root.channel-error;
                    color: #f87171;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    PrimaryButton {
                        text: "Cancelar";
                        tint: Theme.active;
                        clicked => { root.channel-modal-open = false; }
                    }
                    PrimaryButton {
                        text: "Criar canal";
                        clicked => { root.create-channel(chan-input.text, root.channel-modal-voice); }
                    }
                }
            }
        }
    }

    // ---------------- banidos do servidor (desbanir)
    if root.bans-open: Rectangle {
        background: #000000b0;
        TouchArea {
            clicked => { root.bans-open = false; }
        }
        Rectangle {
            width: min(440px, parent.width - 32px);
            height: min(parent.height - 64px, bans-col.preferred-height);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.main;
            border-radius: 8px;
            TouchArea { }
            bans-col := VerticalLayout {
                padding: 24px;
                spacing: 8px;
                Text {
                    text: "Banidos";
                    color: Theme.txt;
                    font-size: 22px;
                    font-weight: 700;
                }
                if root.bans.length == 0: Text {
                    text: "Ninguém foi banido deste servidor.";
                    color: Theme.muted;
                }
                for b in root.bans: HorizontalLayout {
                    height: 44px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Avatar {
                            size: 32px;
                            url: b.avatar;
                            initials: b.initials;
                            tint: b.color;
                        }
                    }
                    Text {
                        text: b.name;
                        color: Theme.txt;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    VerticalLayout {
                        alignment: center;
                        SmallButton {
                            text: "Desbanir";
                            clicked => { root.confirmed("unban:" + b.id); }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    SmallButton {
                        text: "Fechar";
                        clicked => { root.bans-open = false; }
                    }
                }
            }
        }
    }

    // ---------------- modal: confirmar (sair, excluir, apagar)
    if root.confirm-open: Rectangle {
        background: #000000b0;
        TouchArea {
            clicked => { root.confirm-open = false; }
        }
        Rectangle {
            width: 440px;
            height: confirm-col.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.main;
            border-radius: 8px;
            TouchArea { }
            confirm-col := VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text {
                    text: root.confirm-title;
                    color: Theme.txt;
                    font-size: 20px;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                Text {
                    text: root.confirm-body;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    PrimaryButton {
                        text: "Cancelar";
                        tint: Theme.active;
                        clicked => { root.confirm-open = false; }
                    }
                    PrimaryButton {
                        text: root.confirm-button;
                        tint: Theme.danger;
                        clicked => {
                            root.confirm-open = false;
                            if root.confirm-action == "leave-server" {
                                root.leave-server();
                            } else if root.confirm-action == "delete-server" {
                                root.delete-server();
                            } else {
                                // "delete-channel:<id>" / "delete-message:<id>"
                                root.confirmed(root.confirm-action);
                            }
                        }
                    }
                }
            }
        }
    }

    // ---------------- modal: adicionar servidor
    if root.add-open: Rectangle {
        background: #000000b0;
        TouchArea {
            clicked => { root.add-open = false; }
        }
        Rectangle {
            width: 460px;
            height: 250px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.main;
            border-radius: 8px;
            TouchArea { }
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text {
                    text: "Adicionar um servidor";
                    color: Theme.txt;
                    font-size: 22px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Digite o nome de um servidor novo, ou o código de convite de um existente.";
                    color: Theme.muted;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
                add-input := LineEdit {
                    placeholder-text: "Servidor da galera  /  a1b2c3d4";
                }
                if root.add-error != "": Text {
                    text: root.add-error;
                    color: #f87171;
                }
                HorizontalLayout {
                    spacing: 8px;
                    PrimaryButton {
                        text: "Criar servidor";
                        clicked => { root.create-server(add-input.text); }
                    }
                    PrimaryButton {
                        text: "Entrar com convite";
                        tint: Theme.ok;
                        clicked => { root.join-server(add-input.text); }
                    }
                }
            }
        }
    }

    // ---------------- login (cobre tudo até logar)
    if root.ready && !root.logged-in && !root.auth-mfa-mode: AuthScreen {
        error <=> root.auth-error;
        info <=> root.auth-info;
        busy: root.auth-busy;
        code-sent <=> root.auth-code-sent;
        login(e, p) => { root.login(e, p); }
        register(e, p, u) => { root.register(e, p, u); }
        send-reset(e) => { root.send-reset(e); }
        reset-password(e, c, p) => { root.reset-password(e, c, p); }
        leave-forgot => { root.leave-forgot(); }
        confirm-mode <=> root.auth-confirm;
        confirm-signup(e, c) => { root.confirm-signup(e, c); }
        resend-signup(e) => { root.resend-signup(e); }
        email <=> root.auth-email;
        password <=> root.auth-password;
        username <=> root.auth-username;
        accepted: root.legal-accepted;
        start-accept => {
            root.legal-accept-flow = true;
            root.legal-step = 0;
            root.legal-read = false;
            root.legal-age = false;
            root.open-legal("termos");
        }
    }

    // ---------------- Termos de Uso / Política de Privacidade (por cima até do login)
    if root.legal-open: Rectangle {
        background: #000000b0;
        TouchArea {
            clicked => {
                root.legal-open = false;
                root.legal-accept-flow = false;
            }
        }
        legal-box := Rectangle {
            // Chegou ao fim do texto (ou o texto cabe inteiro na tela).
            property <bool> at-end: legal-flick.content-y <= legal-flick.height - legal-flick.content-height + 8px;
            changed at-end => {
                if self.at-end {
                    root.legal-read = true;
                }
            }
            width: min(680px, parent.width - 32px);
            height: parent.height - 64px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.main;
            border-radius: 8px;
            TouchArea { }
            VerticalLayout {
                padding-top: 20px;
                padding-bottom: root.legal-accept-flow ? 68px : 16px; // espaço do rodapé de aceite
                spacing: 12px;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 20px;
                    spacing: 12px;
                    Text {
                        text: root.legal-title;
                        color: Theme.txt;
                        font-size: 20px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    SmallButton {
                        text: root.legal-accept-flow ? "Cancelar" : "Fechar";
                        clicked => {
                            root.legal-open = false;
                            root.legal-accept-flow = false;
                        }
                    }
                }
                if root.legal-accept-flow: Text {
                    x: 24px;
                    text: "Passo " + (root.legal-step + 1) + " de 2 — leia até o fim para continuar";
                    color: Theme.faint;
                    font-size: 12px;
                }
                legal-flick := Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        padding-bottom: 16px;
                        spacing: 6px;
                        alignment: start;
                        for b in root.legal-blocks: Text {
                            text: b.kind == 2 ? "•  " + b.text : b.text;
                            color: b.kind == 1 ? Theme.txt : Theme.muted;
                            font-size: b.kind == 1 ? 16px : 14px;
                            font-weight: b.kind == 1 ? 700 : 400;
                            height: b.kind == 3 ? 6px : self.preferred-height;
                            wrap: word-wrap;
                        }
                    }
                }
            }
            if root.legal-accept-flow: HorizontalLayout {
                x: 0;
                y: legal-box.height - 60px;
                width: legal-box.width;
                height: 44px;   // fixo: o rodapé não pode mudar a altura do texto rolável
                padding-left: 24px;
                padding-right: 20px;
                padding-top: 4px;
                spacing: 12px;
                if root.legal-step == 1: CheckBox {
                    text: "Tenho 13 anos ou mais";
                    checked <=> root.legal-age;
                }
                Text {
                    text: !(root.legal-read || legal-box.at-end) ? "↓ Role até o fim para continuar"
                        : root.legal-step == 1 && !root.legal-age ? "Marque a caixinha para continuar" : "";
                    color: Theme.muted;
                    font-size: 13px;
                    height: 40px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                PrimaryButton {
                    width: 220px;
                    text: root.legal-step == 0 ? "Li e concordo" : "Aceitar e criar conta";
                    tint: Theme.ok;
                    enabled: (root.legal-read || legal-box.at-end) && (root.legal-step == 0 || root.legal-age);
                    clicked => {
                        if root.legal-step == 0 {
                            root.legal-step = 1;
                            root.legal-read = false;
                            root.open-legal("privacidade");
                            legal-flick.content-y = 0;
                        } else {
                            root.legal-accepted = true;
                            root.legal-open = false;
                            root.legal-accept-flow = false;
                            root.register(root.auth-email, root.auth-password, root.auth-username);
                        }
                    }
                }
            }
        }
    }

    // ---------------- carregando
    if !root.ready: Rectangle {
        background: Theme.rail;
        Text {
            text: "Polley";
            color: Theme.brand;
            font-size: 32px;
            font-weight: 900;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // ---------------- aviso rápido (foi removido de um servidor, erro de moderação...)
    // Menu do botão direito numa pessoa: aparece onde clicou (sem sair da janela). Clicar fora fecha.
    if root.um-open: TouchArea {
        clicked => { root.um-open = false; }
        pointer-event(ev) => {
            if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down { root.um-open = false; }
        }
    }
    if root.um-open: Rectangle {
        width: 240px;
        height: um-col.preferred-height;
        x: max(8px, min(root.um-x, root.width - self.width - 8px));
        y: max(8px, min(root.um-y, root.height - self.height - 8px));
        border-radius: 6px;
        background: #111214;
        border-width: 1px;
        border-color: #2b2d31;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000090;
        TouchArea { }   // clique aqui dentro não fecha
        um-col := VerticalLayout {
            padding: 6px;
            MenuItem {
                text: "Perfil";
                clicked => { root.um-open = false; root.show-profile(root.um-me ? "" : root.um-id); }
            }
            if root.pref-dev: MenuItem {
                text: "Copiar ID do usuário";
                clicked => { root.um-open = false; root.copy-id(root.um-id); }
            }
            if !root.um-me && root.um-relation != "blocked": MenuItem {
                text: "Mensagem";
                clicked => { root.um-open = false; root.user-menu("message", root.um-id); }
            }
            if !root.um-me && root.um-relation == "friend": MenuItem {
                text: "Iniciar chamada";
                clicked => { root.um-open = false; root.user-menu("call", root.um-id); }
            }
            // ---- volume (só nos outros)
            if !root.um-me: MenuSep { }
            if !root.um-me: VerticalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 4px;
                padding-bottom: 2px;
                spacing: 2px;
                HorizontalLayout {
                    Text {
                        text: "Volume do usuário";
                        color: Theme.txt;
                        font-size: 14px;
                        font-weight: 500;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: round(root.vol-value) + "%";
                        color: root.vol-value > 100.5 ? Theme.ok : root.vol-value < 0.5 ? Theme.danger : Theme.muted;
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
                Slider {
                    minimum: 0;
                    maximum: 200;
                    value <=> root.vol-value;
                    changed(v) => { root.set-user-volume(root.um-id, v); }
                }
            }
            // ---- eu: mutar / ensurdecer / editar perfil
            if root.um-me: MenuSep { }
            if root.um-me: MenuCheck {
                text: "Silenciar";
                checked: root.voice-muted;
                clicked => { root.toggle-mute(); }
            }
            if root.um-me: MenuCheck {
                text: "Desativar áudio";
                checked: root.voice-deafened;
                clicked => { root.toggle-deafen(); }
            }
            if root.um-me: MenuItem {
                text: "Editar perfil";
                clicked => { root.um-open = false; root.open-profile(); }
            }
            // ---- outros: silenciar só para mim / esconder câmera
            if !root.um-me: MenuSep { }
            if !root.um-me: MenuCheck {
                text: "Silenciar";
                checked: root.um-muted;
                clicked => { root.um-open = false; root.user-menu("mute", root.um-id); }
            }
            if !root.um-me: MenuCheck {
                text: "Desativar vídeo";
                checked: root.um-hide-cam;
                clicked => { root.um-open = false; root.user-menu("hide-cam", root.um-id); }
            }
            // ---- amizade e bloqueio
            if !root.um-me: MenuSep { }
            if !root.um-me && root.um-relation == "none": MenuItem {
                text: "Adicionar amigo";
                clicked => { root.um-open = false; root.user-menu("add-friend", root.um-id); }
            }
            if !root.um-me && root.um-relation == "incoming": MenuItem {
                text: "Aceitar pedido de amizade";
                clicked => { root.um-open = false; root.user-menu("accept-friend", root.um-id); }
            }
            if !root.um-me && root.um-relation == "outgoing": MenuItem {
                text: "Pedido de amizade enviado";
                enabled: false;
            }
            if !root.um-me && root.um-relation != "blocked": MenuItem {
                text: "Bloquear";
                danger: true;
                clicked => {
                    root.um-open = false;
                    root.ask("block:" + root.um-id, "Bloquear " + root.um-name + "?",
                        "Vocês param de ser amigos e ela não consegue mais te mandar mensagem. Dá para desbloquear depois em Amigos → Bloqueado.", "Bloquear");
                }
            }
            if !root.um-me && root.um-relation == "blocked": MenuItem {
                text: "Desbloquear";
                clicked => { root.um-open = false; root.user-menu("unblock", root.um-id); }
            }
            // ---- moderação (dono/admin do servidor)
            if root.um-can-mod: MenuSep { }
            if root.um-can-mod: MenuItem {
                text: "Expulsar " + root.um-name;
                danger: true;
                clicked => {
                    root.um-open = false;
                    root.ask("kick:" + root.um-id, "Expulsar " + root.um-name + "?",
                        "A pessoa sai do servidor agora, mas pode voltar se receber o código de convite de novo.", "Expulsar");
                }
            }
            if root.um-can-mod: MenuItem {
                text: "Banir " + root.um-name;
                danger: true;
                clicked => {
                    root.um-open = false;
                    root.ask("ban:" + root.um-id, "Banir " + root.um-name + "?",
                        "A pessoa sai do servidor e não consegue voltar nem com o código de convite. Dá para desbanir depois em Menu do servidor → Banidos.", "Banir");
                }
            }
            if root.um-can-mod: MenuCheck {
                text: "Silenciar voz no servidor";
                danger: true;
                checked: root.um-srv-muted;
                clicked => { root.um-open = false; root.user-menu("srv-mute", root.um-id); }
            }
            if root.um-can-mod: MenuCheck {
                text: "Desativar áudio no servidor";
                danger: true;
                checked: root.um-srv-deafened;
                clicked => { root.um-open = false; root.user-menu("srv-deafen", root.um-id); }
            }
            // ---- o que aparece na tela da chamada
            MenuSep { }
            MenuCheck {
                text: "Mostrar participantes sem vídeo";
                checked: root.show-no-video;
                clicked => { root.user-menu("show-no-video", root.um-id); }
            }
            if root.um-me: MenuCheck {
                text: "Mostrar minha própria câmera";
                checked: root.show-own-camera;
                clicked => { root.user-menu("show-own-camera", root.um-id); }
            }
        }
    }

    // Seletor de emojis: reagir a uma mensagem ou colocar no texto.
    if root.picker-open: TouchArea {
        clicked => { root.picker-open = false; }
    }
    if root.picker-open: Rectangle {
        property <int> cols: 8;
        width: 8 * 40px + 16px;
        height: pick-col.preferred-height;
        x: parent.width - self.width - 24px;
        y: parent.height - self.height - 84px;
        border-radius: 8px;
        background: #111214;
        border-width: 1px;
        border-color: #2b2d31;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000090;
        TouchArea { }
        pick-col := VerticalLayout {
            padding: 8px;
            spacing: 6px;
            Text {
                text: root.picker-for != "" ? "Reagir" : "Emojis";
                color: Theme.muted;
                font-size: 12px;
                font-weight: 700;
            }
            Rectangle {
                height: ceil(root.emoji-list.length / 8) * 40px;
                for e[i] in root.emoji-list: Rectangle {
                    x: Math.mod(i, 8) * 40px;
                    y: floor(i / 8) * 40px;
                    width: 40px;
                    height: 40px;
                    border-radius: 6px;
                    background: e-ta.has-hover ? Theme.hover : transparent;
                    Image {
                        x: 6px;
                        y: 6px;
                        width: 28px;
                        height: 28px;
                        source: Emoji.image(e);
                    }
                    e-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if root.picker-for != "" {
                                root.react(root.picker-for, e);
                                root.picker-open = false;
                            } else {
                                root.composer-text = root.composer-text + e;
                            }
                        }
                    }
                }
            }
        }
    }

    if root.notice != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.update-version != "" && !root.update-later ? 128px : 56px;
        width: min(480px, parent.width - 32px);
        height: 56px;
        border-radius: 10px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.danger;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000090;
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 10px;
            spacing: 10px;
            Text {
                text: root.notice;
                color: Theme.txt;
                font-size: 13px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }
            VerticalLayout {
                alignment: center;
                SmallButton {
                    text: "OK";
                    clicked => { root.notice = ""; }
                }
            }
        }
    }

    // ---------------- atualização pronta (em cima de tudo; nunca reinicia sozinho)
    if root.update-version != "" && !root.update-later: Rectangle {
        x: (parent.width - self.width) / 2;
        // logo abaixo do cabeçalho (48px) para não cobrir as abas e botões dele
        y: root.incoming-dm != "" ? 120px : 56px;
        width: min(520px, parent.width - 32px);
        height: 64px;
        border-radius: 10px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.ok;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000090;
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 12px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: "Nova versão do Polley pronta (" + root.update-version + ")";
                    color: Theme.txt;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: root.update-notes != "" ? root.update-notes : "Reinicie para atualizar. Leva poucos segundos.";
                    color: Theme.muted;
                    font-size: 12px;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                GhostButton {
                    text: "Depois";
                    clicked => { root.update-later = true; }
                }
            }
            VerticalLayout {
                alignment: center;
                SmallButton {
                    text: "Reiniciar";
                    tint: Theme.ok;
                    clicked => { root.install-update(); }
                }
            }
        }
    }
}
